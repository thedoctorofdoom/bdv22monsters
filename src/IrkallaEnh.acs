//Irkalla Enhancement
bool Irkalla = False;
Script "BD_ME_12207479954307127869" // MAP11
{
	Irkalla = True;
}

script "Irkalla_Mastermind_Patch"
{
	delay(1); 
	if(Irkalla == False) terminate;
	else 
		GiveInventory("Irkalla_Loaded",1);
		SetActorProperty(0,APROP_HEALTH,9005); 
		SetActorProperty(0,APROP_SPEED,28.0);
		SetActorState(0, "IsIrkalla");
}