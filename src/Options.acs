	SetCVAR("bd_CrossPlasma", random(1,99));
	SetCVAR("bd_CrossRailgun", random(1,99));
	SetCVAR("bd_CrossBFG9K", random(1,99));
	SetCVAR("bd_CrossBFG10K", random(1,99));
	SetCVAR("bd_CrossUnmaker", random(1,99));
