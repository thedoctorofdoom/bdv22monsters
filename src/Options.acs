// Zombieman Spawner
Script "ZombiemanSpawner" (Void)
{
    static str monsterType[] =
    {
        "ReplaceRifle", "ReplacePistol", "ReplaceAxeman"
    };

    delay(1);

    if (bd_zombiemanspawn == 0)
    {
        int roll = Random(0, 255); // Generate a number between 0 and 255

        if (roll <= 1) // 1/256 chance for ReplaceAxeman
        {
            SetActorState(0, "ReplaceAxeman");
        }
        else if (roll <= 140) // 140/256 chance for ReplacePistol
        {
            SetActorState(0, "ReplacePistol");
        }
        else // Remaining 115/256 chance defaults to ReplaceRifle
        {
            SetActorState(0, "ReplaceRifle");
        }
    }
    else
    {
        // Ensure bd_zombiemanspawn is within array bounds
        if (bd_zombiemanspawn >= 1 && bd_zombiemanspawn <= 3)
        {
            SetActorState(0, monsterType[bd_zombiemanspawn - 1]);
        }
    }
}

// Shotgunguy Spawner
Script "ShotgunguySpawner" (void)
{
    static str monsterType[] = { "ReplaceShotgun", "ReplaceSMG" };

    delay(1);

    if (bd_shotgunguyspawn == 0)
    {
        int roll = Random(0, 255); // Generate a number between 0 and 255

        if (roll <= 32) // 32/256 chance for ReplaceSMG
        {
            SetActorState(0, "ReplaceSMG");
        }
        else // Remaining 224/256 chance defaults to ReplaceShotgun
        {
            SetActorState(0, "ReplaceShotgun");
        }
    }
    else if (bd_shotgunguyspawn >= 1 && bd_shotgunguyspawn <= 2)
    {
        SetActorState(0, monsterType[bd_shotgunguyspawn - 1]);
    }
}

