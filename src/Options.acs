        if (roll <= 4) // 4/256 chance for Unmaker
        {
            SetActorState(0, "Unmaker");
        }
        else if (roll <= 48) // 48/256 chance for "ForceSpawn2"
        {
            SetActorState(0, "ForceSpawn2");
        }
        else // Remaining 204/256 chance defaults to "Vanilla"
        {
            SetActorState(0, "Vanilla");
        }
    }
    else if (bd_BFGSpawner >= 1 && bd_BFGSpawner <= 3)
    {
        SetActorState(0, spawnType[bd_BFGSpawner - 1]);
    }
}


// Ammo Supply Checker
Script "AmmoSupplyChecker" (Void)
{
    static str spawnType[] = { "Vanilla", "BDV22Style" };
    int numSpawns = 2;
    int jumpChance = 48;

    delay(1);

    if (BD_AmmoPackCheck == 0)
    {
        if (Random(0, 255) < jumpChance)
        {
            int randomIndex = Random(0, numSpawns - 1);
            SetActorState(0, spawnType[randomIndex]);
        }
    }
    else if (BD_AmmoPackCheck >= 1 && BD_AmmoPackCheck <= numSpawns)
    {
        SetActorState(0, spawnType[BD_AmmoPackCheck - 1]);
    }
}

