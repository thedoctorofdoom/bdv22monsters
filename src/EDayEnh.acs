// EDay Enhancements
Script "BD_ME_4691185847364288821" // EDAY06
{
	Delay(1);
	int prev_WadCheck = bd_WadCheck; // store initial cvar value.
	
	if(bd_WadCheck != 3)
		bd_WadCheck = 3; // set to evil marine enemy type.
		
	delay(35);	
		bd_WadCheck = prev_WadCheck; // reset back to previous cvar value.
}