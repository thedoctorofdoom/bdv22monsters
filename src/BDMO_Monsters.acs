// BDMO monster/gore/vehicle ACS.
// Holds only the named scripts that live DECORATE/ZScript code calls by name, plus the
// engine-hook scripts and helpers those scripts depend on. Extracted in Phase 7 from the former
// HUDFX/BOSSHEALTH/CHASECAM/Inputs/Options/DemonMorph/DYNAMICLEV/SLAUGHTER/SPLASH/
// VEHICLECONTROL/WadChecker/WadPatches/zancmpat/SigilIIEnh/EviEnh/IrkallaEnh includes.
// Cvar mirror globals (bd_WadCheck, zdoombrutalblood, ...) are declared in BD_Main.acs;
// shared helpers and the Vehicle* world arrays live in BCSFunc.acs.

//==============================================================================
// zancmpat: lump-reading shim (acs/zancmpat.o + zscript ZandroCompat), used only by the
// TITLEPIC wad-hash detection below.
//==============================================================================

#linklibrary "zancmpat"

enum {LUMP_OPEN_DEFSTART = -2};

extern int ZC_IsZandronum ();
extern int ZC_LumpOpen (str name, int start = LUMP_OPEN_DEFSTART, int flags = 0);
extern void ZC_LumpClose (int lump);
extern raw ZC_LumpGetInfo (int lump, int info = LUMP_READ_UBYTE);
extern str ZC_LumpReadString (int lump, int pos = 0, int len = 0x7FFFFFFF);
extern int ZC_LumpRead (int lump, int pos, int type = LUMP_READ_UBYTE);

//==============================================================================
// Wad detection (WadChecker / *_Wad_Patches read bd_WadCheck; BD_HashTitlepic is the only
// thing that sets it to the per-megawad values 4+).
//==============================================================================

enum
{
	GBL_TITLEHASH = -10555,
	GBL_WADCHECK
};

global raw 45:BD_Globals[];

Script "WadChecker"
{
	delay(2);
	static str WadSelect[] =
	{
		"IsANazi", //Doom 2 (Default Nazi)
		"BW", //Doom 2 (Brutal Wolfenstein Nazi)
		"FormerMarine", //Doom 2 (Former Soldiers)
		"Alieni", //Ancient Aliens
		"Eviternity", //Eviternity
		"ScytheII", //Scythe II
		"Resurgence", //Resurgence
		"ReplaceGoingDown", //Going Down
		"IsEpic2Alien", //Epic 2
		"Bloodstain", //Bloodstain
		"TNTRevilution", //TNT Revilution
		"Jenesis", //Jenesis
		"2048Unleashed", //2048 Unleashed
		"DoomZero", //Doom Zero
		"Wormwood", //Wormwood
		"D64D2", //D64D2
		"FormerMarine", //Hellfire: Dreams
		"NERF" //Not Even Remotely Fair
	};
    if(bd_WadCheck > 0)
        SetActorState(0, wadSelect[bd_WadCheck - 1]);
}

int WadHash[] =
{
	0x3706294F, //Ancient Aliens
	0x692F6439, //Eviternity
	0xC244EABF, //Scythe II
	0x52300A40, //Resurgence
	0x497293A6, //Going Down
	0xD303FA02, //Epic 2
	0x42E57B54, //Bloodstain
	0xE76C8502, //TNT Revilution
	0x1FC2CF3E, //Jenesis
	0xDDD6DE16, //2048 Unleashed
	0x31F67187, //Doom Zero
	0xF69D278A, //Wormwood
	0xE7A8E948, //D64D2
	0x77033279, //Hellfire: Dreams
	0x285402AF //Not Even Remotely Fair
};

bool HasLumpReading ()
{
	static int cached = -1;
	if(cached != -1)
		return (bool)cached;

	cached = ZC_LumpOpen("DECORATE");
	if(cached)
		ZC_LumpClose(cached);

	return cached = !!cached;
}

Script "BD_HashTitlepic" OPEN
{
	int tpic, len, sum;

	enum
	{
		TITLEPIC_MAX = 68500
	};

	if(BD_Globals[GBL_TITLEHASH] != 0)
	{
		bd_WadCheck = BD_Globals[GBL_WADCHECK];
		terminate;
	}
	
	if (!HasLumpReading()) terminate;

    tpic = ZC_LumpOpen("TITLEPIC");

    if(tpic == -1)
        terminate;

    len = ZC_LumpGetInfo(tpic, LUMP_INFO_SIZE);
    len -= len % 4;
    if(len > TITLEPIC_MAX)
		len = TITLEPIC_MAX;

    for(int i = 0; i < len; i += 4)
    {
        sum += ZC_LumpRead(tpic, i, LUMP_READ_INT);
    }

    foreach(let int k, v; WadHash)
    {
        if(sum == v)
        {
			bd_WadCheck = k + 4;
            break;
        }
    }    

    BD_Globals[GBL_TITLEHASH] = sum;
    BD_Globals[GBL_WADCHECK] = bd_WadCheck;
    
    ZC_LumpClose(tpic);
}

script "EvilMarine_Wad_Patches"
{
	delay(1);
	
	if(bd_wadcheck == 6) //Scythe II (Plasma Rifle Marine)
	{
		if(CheckActorClass(27,"MrX")) terminate;
		else 
		SetActorProperty(27,APROP_Health,240); 
		SetActorProperty(27,APROP_Speed,16.0);
	}
	else if(bd_wadcheck == 7) //Resurgence (Plasma Rifle Marine)
	{
		SetActorProperty(27,APROP_Health,250); 
		SetActorProperty(27,APROP_Speed,3.0);
	}
	else if(bd_wadcheck == 10) //Bloodstain (Rifle Marine)
	{
		SetActorProperty(27,APROP_Speed,10.0);
	}
	else if(bd_wadcheck == 12) //Jenesis (Shotgun Marine)
	{
		SetActorProperty(27,APROP_Health,90);
	}
}

script "Afrit_Wad_Patches"
{
	delay(1);
	if(bd_wadcheck == 6) //Scythe II
	{
		SetActorProperty(0,APROP_Health,2500);
	}
	else if(bd_wadcheck == 10) //Bloodstain
	{
		GiveInventory("Bloodstain_Loaded",1);
		SetActorProperty(0,APROP_Health,1500);
		SetActorProperty(0,APROP_Speed,10.0);
		SetActorProperty(0,APROP_Mass,600);	
	}
}

//==============================================================================
// Per-map boss patches. Sigil2/Irkalla were set by the removed map-hash system and now
// always stay False, so these patches always terminate early.
//==============================================================================

bool Sigil2 = False;

script "Sigil2_Mastermind_Patch" 
{ 
	delay(1); 
	if(Sigil2 == False) terminate;
	else 
		SetActorProperty(0,APROP_HEALTH,9000); 
		SetActorState(0, "IsSigil2"); 
}

bool Irkalla = False;

script "Irkalla_Mastermind_Patch"
{
	delay(1); 
	if(Irkalla == False) terminate;
	else 
		GiveInventory("Irkalla_Loaded",1);
		SetActorProperty(0,APROP_HEALTH,9005); 
		SetActorProperty(0,APROP_SPEED,28.0);
		SetActorState(0, "IsIrkalla");
}

