Actor NukeSmoke: HitpuffSmoke
{
	Scale 6.0
	Speed 1
	Alpha 0.1
	+SKYEXPLODE
	+FORCEXYBILLBOARD
	States
	{
	Spawn:  
		SMk2 CCCCCCCCCC 2 A_FadeIn(0.05)
		SMk2 C 600

	Death:
		SMk2 CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 20 A_FadeOut(0.02)
		Stop
	}
}


