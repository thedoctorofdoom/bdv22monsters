ACTOR PoorLostSoul
{
	Radius 16
	Height 8
	Speed 30
	Damage 15
	Projectile
	Scale 1.0
	+FORCEXYBILLBOARD
	DamageType Fire
	ExplosionRadius 70
	ExplosionDamage 50
	Alpha 1
	SeeSound "skull/melee"
	DeathSound "fatso/shotx"
	States
	{
	Spawn:
		LSOL A 0 A_CustomMissile ("FlameTrails", 24, 0, random(-2,2), 0, 0)
		LSOL B 2 BRIGHT A_SpawnItem("RedFlare",0,0)
		Loop

	Death:
		LSOL F 2 BRIGHT
		LSOL G 2 BRIGHT
		TNT1 A 0 A_Explode
		EXPL AAAAAAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile ("FlameTrails", 6, 0, random (0, 360), 2, random (0, 360))
		EXPL A 0 A_SpawnItemEx("ExplosionParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 0)
		TNT1 AAA 0 A_CustomMissile ("LSpart1", 42, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile ("LSpart3", 42, 0, random (0, 360), 2, random (0, 160))
		TNT1 AAAA 0 A_CustomMissile ("LSpart2", 42, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0
		LSOL HI 6
		Stop
	}
}

ACTOR BarrelNukageSpawner
{
	+CLIENTSIDEONLY
	+THRUACTORS
	+NOINTERACTION
	+INVISIBLE
	RenderStyle "none"
	States
	{
	Spawn:
		TNT1 AAA 0 NODELAY A_SpawnItemEX("nukageParticleX",0,0,0,random(-3,3),random(-3,3),random(-3,3),random(0,128),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64)
		TNT1 AAA 0 A_SpawnItemEX("nukageParticleXfaster",0,0,0,random(-3,3),random(-3,3),random(-3,3),random(0,128),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64)
		stop
	}
}


ACTOR ThrowedBarrel
{
	Radius 6
	Height 8
	Speed 32
	Fastspeed 32
	Damage 55
	+MISSILE
	Gravity 0.6
	Scale 1.0
	+FORCEXYBILLBOARD
	DamageType "Explosive"
	Alpha 1
	DeathSound "Barrel/explode"
	tag "$TAGBD_THROWNBARREL"
	States
	{
	Spawn:
		TBRA A 0 NODELAy A_Jump(128,"Stay")
		TBRA A 0 A_SetScale(-scalex,scaley)
	Stay:
		TBRA ABC 2
		TBRA DEFG 2 A_SpawnItemEX("BarrelNukageSpawner",0,0,-30,0,0,0,random(0,128),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
		TBRA HIJ 2
		Loop

	Death:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_SpawnItemEx ("BarrelExplosionDamage",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItemEx ("DetectFloorCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItemEx ("DetectCeilCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItemEx ("ExplosionFlareSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItem("WhiteShockwaveBig")
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAA 0 A_CustomMissile ("GreenLiquidParticleX", random (0, 60), random(-3,3), random (0, 360), 2, random (30, 90))
		TNT1 A 0 A_SpawnItemEx ("BarrelKaboomSilent",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 AAAA 0 A_CustomMissile ("FireworkSFXType2", 64, 0, random (0, 360), 2, random (30, 60))
		TNT1 AAA 0 A_CustomMissile ("HighExplosiveFlames", random (10, 20), 0, random (0, 360), 2, random (10, 90))
		EXPL AA 0 A_CustomMissile ("BigBlackSmokeLarger", 20, 0, random (0, 360), 2, random (10, 90))
		TNT1 AAA 0 A_CustomMissile ("BDExplosionparticles3", 64, 0, random (0, 360), 2, random (40, 90))
		TNT1 AAA 0 A_CustomMissile ("BDExplosionparticles4", 64, 0, random (0, 360), 2, random (40, 90))
		TNT1 A 0 Radius_Quake (2, 24, 0, 15, 0)
		TNT1 B 0 BRIGHT A_Scream
		TNT1 B 0 BRIGHT A_PlaySound("Barrel/explodeDistant", 3)
		TNT1 A 0 A_SpawnItemEX("HorizontalShockwave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 AA 0 A_CustomMissile ("BarrelShrapnel1", 25, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile ("BarrelShrapnel2", 15, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile ("BarrelShrapnel3", 5, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile ("BarrelShrapnel4", 5, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_PlaySound("FAREXPL", 3)
		TNT1 AA 0 A_SpawnItemEx("TinyBurningPiece", random (-15, 15), random (-15, 15))
		TNT1 AA 0 A_SpawnItemEx("TinyBurningPiece2", random (-35, 35), random (-35, 35))
		TNT1 AA 0 A_SpawnItemEx("TinyBurningPiece3", random (-45, 45), random (-45, 35))
		TNT1 A 2
		TNT1 A 0 A_SpawnItemEx ("ExplosionSplashSpawner", 0, 0, 0)
		TNT1 AAA 8 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (50, 130))
		Stop
	}
}

ACTOR KickAttack: FastProjectile
{
	Radius 12
	Height 2
	DamageType Kick
	Projectile
	+FORCEXYBILLBOARD
	+NOEXTREMEDEATH
	RenderStyle "none"
	Damage (random(14,14))
	Speed 30
	Obituary "$OBBD_KICK"
	SeeSound "dsempty"
	DeathSound "dsempty"
	Decal "none"
	States
	{
	Spawn:
		TNT1 AA 1 NODELAY
		Stop

	Death:
	Crash:
		TNT1 A 0 A_AlertMonsters(200)
		TNT1 A 0 A_PlaySound("Kick/wall",3)
		TNT1 A 0 A_SpawnItemEx ("PLOFT2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 AAAAAA 0 A_CustomMissile ("MeleeSmoke", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 A 0 Radius_Quake (2, 6, 0, 5, 0)//(intensity, duration, damrad, tremrad, tid)
		TNT1 A 0 A_CheckFloor("DeathOnGround")
		TNT1 A 10 A_GiveToTarget("KickHasHit", 1)
		Stop

	XDeath:
		TNT1 A 0 A_AlertMonsters(200)
		TNT1 A 0 A_PlaySound("Kick/flesh",3)
		TNT1 A 0 A_SpawnItemEx ("PLOFT2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_GiveToTarget("KickHasHit", 1)
		TNT1 A 0 Radius_Quake (2, 6, 0, 5, 0)//(intensity, duration, damrad, tremrad, tid)
		TNT1 A 10
		Stop

	DeathOnGround:
		TNT1 A 10
		Stop
	}
}

