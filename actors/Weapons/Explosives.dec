actor RocketExplosion
{
	+MISSILE
	Radius 2
	Height 2
	Damagetype "ExplosiveImpact"
	RenderStyle "None"
	Obituary "$OBBD_ROCKETLAUNCHER"
	States
	{
	Spawn:
		Goto Death

	Death:
		TNT1 A 0
		TNT1 A 3 A_SpawnItem("WhiteShockwave")
		TNT1 AAAAAAA 0 A_CustomMissile ("ExplosionAirBurstEffectSmall", 2, 0, random (0, 360), 2, random (-45, 45))
		TNT1 A 0 A_Explode(100,150)
		Stop
	}
}

actor LiquidExplosionEffectSpawner
{
	+NOBLOCKMAP
	+MISSILE
	Radius 2
	Height 2
	Damagetype "CauseWaterSplash"
	RenderStyle "None"
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_Explode(3,9)
		Stop
	}
}

