ACTOR Plasma_Ball: FastProjectile
{
	Radius 10
	Height 2
	Speed 60
	Damage (random(40, 40))
	DamageType Plasma
	Decal "SmallerScorch"
	Projectile
	Species "Marines"
	damagefactor "Blood", 0.0 damagefactor "BlueBlood", 0.0 damagefactor "GreenBlood", 0.0 damagefactor "Taunt", 0.0 damagefactor "KillMe", 0.0 damagefactor "Shrapnel", 0.0
	Health 5
	Scale 1.0
	RenderStyle "Add"
	alpha 0.99
	DeathSound "Plasma/Impact"
	//SeeSound "Plasma/Fire"
	SeeSound "dsempty"
	Obituary "$OBBD_PLASMA"
	+RANDOMIZE
	+SPECTRAL
	-NOBLOCKMAP
	+NOBLOOD
	+NORADIUSDMG
	+THRUSPECIES
	+MTHRUSPECIES
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		PLSS AB 2 BRIGHT
		Loop

	Death:
	XDeath:
		TNT1 A 0
		TNT1 A 0 A_Jump(255, "Var1", "var2", "var3", "var4")
	Var1:
		TNT1 A 0 A_SetScale (0.8, 0.8)
		TNT1 AA 0 A_CustomMissile ("BluePlasmaParticle", 0, 0, random (0, 360), 2, random (0, 360))
		PLX6 ABCDEFGHIJKLMNOPQRSTUVWXY 1 BRIGHT
		Stop

	Var2:
		TNT1 A 0 A_SetScale (-0.7, 0.7)
		TNT1 AA 0 A_CustomMissile ("BluePlasmaParticle", 0, 0, random (0, 360), 2, random (0, 360))
		PLX6 ABCDEFGHIJKLMNOPQRSTUVWXY 1 BRIGHT
		Stop

	Var3:
		TNT1 A 0 A_SetScale (-0.6, 0.6)
		TNT1 AA 0 A_CustomMissile ("BluePlasmaParticle", 0, 0, random (0, 360), 2, random (0, 360))
		PLX6 ABCDEFGHIJKLMNOPQRSTUVWXY 1 BRIGHT
		Stop

	Var4:
		TNT1 A 0 A_SetScale (0.9, 0.9)
		TNT1 AA 0 A_CustomMissile ("BluePlasmaParticle", 0, 0, random (0, 360), 2, random (0, 360))
		PLX6 BCDEFGHIJKLMNOPQRSTUVWXY 1 BRIGHT
		Stop
	}
}


ACTOR PlasmaBall75: Plasma_Ball
{
	Damage (random(50, 50))
	SeeSound "Plasma/Fire"
}

ACTOR PlasmaBall99: Plasma_Ball
{
	Damage (random(60, 60))
	SeeSound "Plasma/Fire"
}

ACTOR PlasmaBallDM: Plasma_Ball Replaces PlasmaBall
{
	Speed 50
	-THRUSPECIES
	-MTHRUSPECIES
	Species "None"
	Damage (random(40, 40))
}