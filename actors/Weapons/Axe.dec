ACTOR AxePuffs: BulletPuff
{
	RenderStyle "Translucent"
	scale 0.15
	alpha 0.7
	Radius 20
	damagetype Saw
	decal "none"
	+NOBLOCKMAP
	+NOGRAVITY
	+NOEXTREMEDEATH
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	states
	{
	Spawn:
	Death:
	XDeath:
	Melee:
		TNT1 A 20
		Stop
	}
}






ACTOR ThrowedAxe
{
	Radius 8
	Height 8
	Speed 30
	Damage (random(120, 120))
	Projectile
	-NOGRAVITY
	+FORCEXYBILLBOARD
	+NOEXTREMEDEATH
	+SKYEXPLODE
	+NOEXTREMEDEATH
	+THRUSPECIES
	+BLOODSPLATTER
	+USEBOUNCESTATE
	Species "Marines"
	Gravity 1.0
	scale 0.75
	BounceType "doom"
	BounceCount 3
	BounceFactor 0.3
	WallBounceFactor 0.4
	Damagetype "Saw"
	States
	{
	Bounce:
		AXEG A 0 A_SpawnItem ("Sparks", 0)
		AXEG A 0 A_PlaySound("Axe/Wall", 6)
	Spawn:
		AXET A 2
		AXET B 2 A_PlaySound("Axe/Woosh1", CHAN_BODY)
		AXET C 2
		AXET D 2 A_PlaySound("Axe/Woosh2", CHAN_BODY)
		AXET E 2
		AXET F 2 A_PlaySound("Axe/Woosh1", CHAN_BODY)
		AXET G 2
		AXET H 2 A_PlaySound("Axe/Woosh2", CHAN_BODY)
		Loop
	Death:
		TNT1 A 0
		TNT1 A 0 A_SpawnItem ("Sparks", 0)
		TNT1 A 0 A_PlaySound("Axe/Wall", 6)
	XDeath:
		TNT1 A 0
		TNT1 A 0 A_spawnItem("BrutalAxe")
	Stop
	}
}


ACTOR ThrowedAxeStrong: ThrowedAxe
{
	+RIPPER
	Speed 35
	Damagetype "Saw"
	Damage (random(64, 64))
	BounceCount 0
	BounceType "none"
	States
	{
	Death:
		TNT1 A 0
		TNT1 A 0 A_SpawnItem ("Sparks", 0)
		TNT1 A 0 A_PlaySound("Axe/Wall", 6)
		TNT1 A 0 A_CheckFloor("XDEATH")
		TNT1 A 0 A_spawnItem("BrutalAxeOnWall")
		stop
	}
}



ACTOR BrutalAxeOnWall: CustomInventory
{
	scale 0.75
	+NOGRAVITY
	+SHOOTABLE
	Health 1
	+NOBLOOD
	PainChance 266
	Mass 200
	Inventory.PickupSound "Axe/Draw"
	Inventory.Pickupmessage "$GOTAXE2"
    States
    {
	Pain:
	Death:
		TNT1 A 0
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_ChangeFlag("SHOOTABLE",0)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",0)
		TNT1 A 0 ThrustThingZ(0,10,0,1)
		AXET A 2 A_CheckFloor("SpawnAxe")
		wait
	SpawnAxe:
		AXEG A 0 A_SpawnItem ("Sparks", 0)
		AXEG A 0 A_PlaySound("Axe/Wall", 6)
		TNT1 A 1 A_spawnItem("BrutalAxe")
		stop
	 Spawn:
		AXET A 1
		AXET A -1
		Stop
	Pickup:
	    TNT1 A 0
		TNT1 A 0 A_GiveInventory("BrutalAxe", 1)
		Stop
    }
}