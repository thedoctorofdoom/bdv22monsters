/////////////SHOCKWAVES

ACTOR GreenShockWave
{
	Speed 0
	Height 64
	Radius 32
	Scale 2.25
	RenderStyle "Add"
	Alpha 0.9
	+DROPOFF
	+NOBLOCKMAP
	+NOGRAVITY
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	+NOINTERACTION
	States
	{
	Spawn:
		SHOK A 1 BRIGHT
		Goto Death
	Death:
		SHOK BCDEFGHIJKLMNOPQR 1 BRIGHT A_FadeOut(0.05)
		Stop
	}
}

ACTOR WhiteShockWave: GreenShockwave
{
	Scale 2.0
	Alpha 0.12
	States
	{
	Spawn:
		SHWK A 1
		SHWK CEGIKMOQ 1 A_FadeOut(0.01)
		Stop
	}
}

ACTOR WhiteShockWaveBig: WhiteShockWave { Scale 3.0 }
ACTOR WhiteShockWaveSmall: WhiteShockWave { Scale 1.0 }

ACTOR BFGFOG
{
	Radius 1
	Height 1
	Alpha 0.7
	RenderStyle "Add"
	Scale 0.4
	Speed 8
	Gravity 0
	+NOBLOCKMAP
	+NOTELEPORT
	+DONTSPLASH
