Actor JenesisBoss
{
	Health 5000
	Radius 16
	Height 216
	Mass 10000000
	+SPAWNCEILING
	+NOGRAVITY
	+Shootable
	+BOSS
	+SOLID
	PainChance "Avoid", 50
	PainChance "Head", 255
	PainChance "Kick", 256 PainChance "Slide", 256
	PainChance "Melee", 255 PainChance "HangingHook", 0 PainChance "Stealth", 255
	PainChance "HelperMarineFatality", 255
	PainChance "MonsterKnocked", 256
	PainChance "ExplosiveImpact", 256
	damagefactor "Crush", 5.0 DamageFactor "Fatality", 5.0 damagefactor "FallInLava", 500.0
	PainChance "Taunt", 255
	damagefactor "Avoid", 0.0
	damagefactor "DontCallTheBaron", 0.0 damagefactor "PussyGrab", 50.0
	damagefactor "TeleportRemover", 0.0
	damagefactor "GibRemoving", 0.0
	damagefactor "SSG", 50.0
	PainChance "LowKick", 255
	damagetype "Melee"
	PainSound "JenesisBoss/Pain"
	DeathSound "JenesisBoss/Death"
	+USEKILLSCRIPTS
	States
	{
	Spawn:
		JSUS D 10 A_Look
		goto Spawn

	See:
		TNT1 A 0
		TNT1 A 0 ACS_NamedExecuteAlways("BD_BossHealthBar", 0)//Health Bar

	Chasing:
		JSUS ABCDCB 4 A_Chase
		loop

	Pain:
		JSUS A 24 A_Pain
		JSUS ABCDCB 4 A_Chase
		goto See

	Missile:
		JSUS A 6 A_FaceTarget
		JSUS BABA 6 Bright A_CustomMissile("revenantseekermissiles",50,10,0,0)
		JSUS ABCDCB 4 A_Chase
		goto See

	Death:
		JSUS A 100 Bright A_BrainScream
		JSUS D -1 Bright A_BrainDie
		stop
	}
}

Actor Heart
{
	Health 12000
	Radius 16
	Height 128
	PainChance 10
	Mass 10000000
	+SPAWNCEILING
	+NOGRAVITY
	+Shootable
	+BOSS
	+SOLID
	+NOBLOOD
	PainChance "Avoid", 50
	PainChance "Head", 255
	PainChance "Kick", 256 PainChance "Slide", 256
	PainChance "Melee", 255 PainChance "HangingHook", 0 PainChance "Stealth", 255
	PainChance "HelperMarineFatality", 255
	PainChance "MonsterKnocked", 256
	PainChance "ExplosiveImpact", 256
	damagefactor "Crush", 5.0 DamageFactor "Fatality", 5.0 damagefactor "FallInLava", 500.0
	PainChance "Taunt", 255
	damagefactor "Avoid", 0.0
	damagefactor "DontCallTheBaron", 0.0 
	damagefactor "PussyGrab", 50.0
	damagefactor "TeleportRemover", 0.0
	damagefactor "GibRemoving", 0.0
	PainChance "LowKick", 255
	damagetype "Melee"
	BloodType "Brutal_Blood", "SawBlood", "SawBlood"
	PainSound "Heart/Pain"
	//DeathSound "Keen/Death"
	+USEKILLSCRIPTS
	States
	{
	Spawn:
		HRTB A 1 Bright A_Look
		goto Spawn

	See:
		TNT1 A 0
		TNT1 A 0 ACS_NamedExecuteAlways("BD_BossHealthBar", 0)//Health Bar

	Chasing:
		HRTB A 15 Bright A_Chase
		HRTB B 5 Bright A_Pain
		HRTB CDE 5 Bright 
		loop

	Pain:
		HRTB B 5 Bright A_FatAttack1
		HRTB C 5 Bright A_FatAttack2
		HRTB D 5 Bright A_FatAttack3
		HRTB A 15 Bright A_Chase
		HRTB B 5 Bright A_Pain
		HRTB CDE 5 Bright 
		goto See

	Missile:
		HRTB BCDE 5 Bright A_BrainSpit
		HRTB A 15 Bright A_Chase
		HRTB B 5 Bright A_Pain
		HRTB CDE 5 Bright 
		goto See

	Death:
		HRTB A 110 Bright A_BrainScream
		HRTB A -1 Bright A_BrainDie
		stop
	}
}