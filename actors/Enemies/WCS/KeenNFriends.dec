///////Commander Keen

Actor Commander_Keen : BDMO_GoreMonster Replaces CommanderKeen
{
	Health 100
	Radius 16
	Height 72
	Mass 10000000
	Painchance 256
	+Solid 
	+SpawnCeiling
	+Nogravity
	+Shootable
	+CountKill
	+NoiceDeath
	+dontfall
	Monster 
	PainChance "Avoid", 50
	PainChance "Head", 255
	PainChance "Kick", 256 PainChance "Slide", 256
	PainChance "Melee", 255 PainChance "HangingHook", 0 PainChance "Stealth", 255
	PainChance "HelperMarineFatality", 255
	PainChance "MonsterKnocked", 256
	PainChance "ExplosiveImpact", 256
	damagefactor "Crush", 5.0 DamageFactor "Fatality", 5.0 damagefactor "FallInLava", 500.0
	PainChance "Taunt", 255
	damagefactor "Avoid", 0.0
	damagefactor "DontCallTheBaron", 0.0 damagefactor "PussyGrab", 50.0
	damagefactor "TeleportRemover", 0.0
	damagefactor "GibRemoving", 0.0
	damagefactor "SSG", 500.0
	PainChance "LowKick", 255
	damagetype "Melee"
	DamageFactor "Head", 1.3
	damagefactor "Melee", 1.35
	damagefactor "Shotgun", 2.0
	BloodType "Brutal_Blood", "SawBlood", "SawBlood"
	PainSound "Keen/Pain"
	DeathSound "Keen/Death"
	+USEKILLSCRIPTS
	States
	{
	Spawn:
		KEEN A 2
		KEEN A 0 ACS_NamedExecuteAlways("WadChecker",0,0,0,0)
		KEEN A 1
	Standing:
		KEEN A -1
		Loop

	EVITERNITY:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("NOTARGET", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx("CacoAsshole", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS | SXF_TRANSFERAMBUSHFLAG) //Sorry Antares,green chaingunners are too boring and simple to be worth of a full brutalization process
		Stop

	ScytheII:
	Resurgence:
	Bloodstain:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("NOTARGET", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx("Afrit", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_TRANSFERAMBUSHFLAG)
		Stop

	TNTRevilution:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("NOTARGET", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx("TNTRevilutionDITEAMFORTRESS2_2", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS | SXF_TRANSFERAMBUSHFLAG)
		Stop

	Alieni:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("NOTARGET", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx("AncientFlyingCunt", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_TRANSFERAMBUSHFLAG)
		Stop

	Jenesis:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("NOTARGET", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx("JenesisBoss", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_TRANSFERAMBUSHFLAG)
		Stop

	2048Unleashed:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("NOTARGET", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx("Heart", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_TRANSFERAMBUSHFLAG)
		Stop

	DoomZero:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("NOTARGET", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx("DopeFish", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_TRANSFERAMBUSHFLAG)
		Stop

	Wormwood:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("NOTARGET", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx("TheCyberdemon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS ,0, tid)
		Stop

	D64D2:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("NOTARGET", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx("NightmareImp", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_TRANSFERAMBUSHFLAG)
		Stop

	NERF:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("NOTARGET", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx("TheSpiderMastermindNERF", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_TRANSFERAMBUSHFLAG)
		Stop	

	Pain:
		KEEN M 4
		KEEN M 8 A_Pain
		Goto Spawn

	Death:
		TNT1 AAAAAA 0 A_CustomMissile ("WaterBloodCHecker", 24, 0, random (0, 360), 2, random (30, 60))
		TNT1 AAAAA 0 A_CustomMissile ("SuperWallRedBlood", 40, 0, random (0, 360), 2, random (-15, 15))
		TNT1 AAAAAAAAA 0 A_CustomMissile ("CeilBloodLauncherLong", 0, 0, random (0, 360), 2, random (50, 130))
		TNT1 AA 0 A_CustomMissile("XDeath1", 32, 0, random (0, 360), 2, random (10, 90))
		TNT1 AAA 0 A_CustomMissile("SuperGoreSpawner", 30, 0, random (0, 360), 2, random (30, 60))
		TNT1 AAAA 0 A_CustomMissile("XDeath2b", 15, 0, random (0, 360), 2, random (10, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath3b", 15, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("XDeathOrgan1", 24, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("XDeathOrgan2", 24, 0, random (0, 360), 2, random (10, 90))
		TNT1 AAAAAAA 0 A_CustomMissile("Guts", 32, 0, random (0, 360), 2, random (60, 90))
		TNT1 A 0 A_CustomMissile("KeensHead", 32, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("KeensArm", 32, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("KeensArmLeft", 32, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("XDeathKeenLeg", 32, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("XDeathKeenLegLeft", 32, 0, random (0, 360), 2, random (10, 90))		
		TNT1 A 0 A_SpawnItem("BigBloodSpot")
		TNT1 AAAAAA 0 A_CustomMissile("BloodMistExtraBig", 30, 0, random (0, 360), 2, random (40, 90)) 
		KEEN O 6 A_Scream
		KEEN PQ 6 A_NoBlocking
		KEEN R 6 A_KeenDie
		KEEN S -1
		Stop
		
	Death.Explosive:
		TNT1 AAAAAA 0 A_CustomMissile ("WaterBloodCHecker", 24, 0, random (0, 360), 2, random (30, 60))
		TNT1 AAAAA 0 A_CustomMissile ("SuperWallRedBlood", 40, 0, random (0, 360), 2, random (-15, 15))
		TNT1 AAAAAAAAA 0 A_CustomMissile ("CeilBloodLauncherLong", 0, 0, random (0, 360), 2, random (50, 130))
		TNT1 AA 0 A_CustomMissile("XDeath1", 32, 0, random (0, 360), 2, random (10, 90))
		TNT1 AAA 0 A_CustomMissile("SuperGoreSpawner", 30, 0, random (0, 360), 2, random (30, 60))
		TNT1 AAAA 0 A_CustomMissile("XDeath2b", 15, 0, random (0, 360), 2, random (10, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath3b", 15, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("XDeathOrgan1", 24, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("XDeathOrgan2", 24, 0, random (0, 360), 2, random (10, 90))
		TNT1 AAAAAAA 0 A_CustomMissile("Guts", 32, 0, random (0, 360), 2, random (60, 90))
		TNT1 A 0 A_CustomMissile("KeenHeadExplode", 32, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("KeensArm", 32, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("KeensArmLeft", 32, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("XDeathKeenLeg", 32, 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile("XDeathKeenLegLeft", 32, 0, random (0, 360), 2, random (10, 90))		
		TNT1 A 0 A_SpawnItem("BigBloodSpot")
		TNT1 AAAAAA 0 A_CustomMissile("BloodMistExtraBig", 30, 0, random (0, 360), 2, random (40, 90)) 
		KEEN O 6 A_XScream
		KEEN PQ 6 A_NoBlocking
		KEEN R 6 A_KeenDie
		KEEN S -1
		Stop	
	}
}

// Afrit

Actor Afrit : BDMO_GoreMonster
{
	Health 1000 //Bloodstain : 1500, Scythe II: 2500
	Speed 8 //Bloodstain : 10
	Radius 20
	Height 72
	Painchance 30
	Mass 400 //Bloodstain : 600
	SeeSound "Baron/Sight"
	PainSound "Baron/Pain"
	DeathSound "Baron/Death"
	ActiveSound "Baron/Active"
	Monster
	+NoGravity
	+NoBlood
	+Float
	+DontHurtSpecies
	Tag "$TAGBD_AFRIT"
	Obituary "$OB_AFRIT"
	HitObituary "$OB_AFRITMELEE"
	damagefactor "Melee", 1.35
	damagefactor "Shotgun", 1.5
	DamageFactor "explosive", 2.5
	DamageFactor "Fire", 0.0
	damagefactor "SSG", 1.5
	PainChance "Taunt", 255
	DamageFactor "Taunt", 0.1
	damagefactor "DontCallTheBaron", 0.0 damagefactor "PussyGrab", 0.0
	damagefactor "Blood", 0.0 damagefactor "BlueBlood", 0.0 damagefactor "GreenBlood", 0.0  damagefactor "PurpleBlood", 0.0
	DamageFactor "CauseSplash", 0.0 DamageFactor "CauseObjectsToSplashSlime", 0.0 DamageFactor "CauseObjectsToSplashNukage", 0.0
	DamageFactor "CauseObjectsToSplashBlood", 0.0 DamageFactor "CauseObjectsToSplashLava", 0.0
	+USEKILLSCRIPTS
	States
	{
	Spawn:
		FRIT A 2 
		FRIT A 0 ACS_NamedExecuteWithResult("Afrit_Wad_Patches",0,0,0,0)
		FRIT A 1
	Stand: 
		FRIT A 0 A_CustomMissile("OrbitComet", 44, 0, 0, 2, 0)
		FRIT A 0 A_CustomMissile("OrbitComet2", 44, 0, 180, 2, 0)
		FRIT AABB 4 Bright A_Look
		Goto Stand+3

	See:
		FRIT ABCD 3 Bright A_Chase
		Loop

	Missile:
		FRIT EF 6 Bright A_FaceTarget
		TNT1 A 0 A_CustomMissile("BigFireBall",30,25,-20,0)
		TNT1 A 0 A_CustomMissile("BigFireBall",30,25,-10,0)
		TNT1 A 0 A_CustomMissile("BigFireBall",30,25,0,0)
		TNT1 A 0 A_CustomMissile("BigFireBall",30,25,10,0)
		TNT1 A 0 A_CustomMissile("BigFireBall",30,25,20,0)
		FRIT G 6 Bright 
		TNT1 A 0 A_JumpIfInventory("Bloodstain_Loaded",1,"See")
		TNT1 A 0 A_CustomMissile("revenantseekermissiles",50,10,-10,0)
		TNT1 A 0 A_CustomMissile("revenantseekermissiles",50,10,0,0)
		TNT1 A 0 A_CustomMissile("revenantseekermissiles",50,10,10,0)
		Goto See

	Pain:
		FRIT H 4 Bright
		FRIT H 4 Bright A_Pain
		Goto See

	Death:
		TNT1 A 0 A_NoGravity
		FRIT I 6 Bright A_Scream
		FRIT J 5 Bright A_NoBlocking
		TNT1 A 0 A_JumpIfInventory("lowgraphicsmode", 1, "DeathCheap")
		TNT1 AA 0 A_SpawnItemEx ("ExplosionFlareSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 AAAA 0 A_CustomMissile ("FireworkSFXType2", 64, 0, random (0, 360), 2, random (30, 60))
		TNT1 AA 0 A_CustomMissile ("BDExplosionparticles", 0, 0, random (0, 360), 2, random (40, 90))
		TNT1 AA 0 A_CustomMissile ("BDExplosionparticles2", 0, 0, random (0, 360), 2, random (40, 90))
		TNT1 AA 0 A_CustomMissile ("BDExplosionparticles3", 10, 0, random (0, 360), 2, random (40, 90))
		EXPL AA 0 A_CustomMissile ("FlamethrowerFireParticles", 6, 0, random (0, 360), 2, random (0, 90))
		//FRFX ZZZ 0 BRIGHT A_CustomMissile ("BigBlackSmoke", 2, 0, random (0, 360), 2, random (0, 30))
		//TNT1 A 2 A_SpawnItem("BurningGroundLowDamage")
		TNT1 AA 0 A_SpawnItemEx("TinyBurningPiece", random (-15, 15), random (-15, 15))
		TNT1 AA 0 A_SpawnItemEx("TinyBurningPiece2", random (-35, 35), random (-35, 35))
		TNT1 AA 0 A_SpawnItemEx("TinyBurningPiece3", random (-45, 45), random (-45, 35))
		TNT1 AAAAA 0 A_CustomMissile ("BigBlackSmoke", 0, 0, random (0, 360), 2, random (40, 160))
	DeathCheap:	
		FRIT KLM 5 Bright
		TNT1 A 0 A_JumpIfInventory("Bloodstain_Loaded",1,"KeenDeath")
		FRIT N 5 Bright A_BossDeath
		FRIT OPQR 5 Bright
		Stop
	KeenDeath:
		FRIT N 5 Bright A_KeenDie
		FRIT OPQR 5 Bright
		Stop
	}
}

