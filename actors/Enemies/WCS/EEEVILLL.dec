		TNT1 A 0 A_PlaySound("Chaingun/Start")
		PL42 E 20 A_FaceTarget
	MissileContinue:
		PL42 F 1 BRIGHT A_CustomMissile("MonsterMinigunTracer", 32, 10, random(-4, 4), 1, random(-2, 2))
		TNT1 A 0 A_CustomMissile("EnemyMinigunBrass", 34, 0, -60, 2, random(20, 55))
		PL42 E 2 A_FaceTarget 
		TNT1 A 0 A_PlaySound("FARMGN", 6)
		TNT1 A 0 A_PlaySound("Chaingun/Fire", 5)
		PL42 F 1 BRIGHT A_CustomMissile("MonsterMinigunTracer", 32, 10, random(-4, 4), 1, random(-2, 2))
		TNT1 A 0 A_CustomMissile("EnemyMinigunBrass", 34, 0, -60, 2, random(20, 55))
		PL42 E 2 A_FaceTarget 
		TNT1 A 0 A_PlaySound("FARMGN", 6)
		TNT1 A 0 A_PlaySound("Chaingun/Fire", 5)
		TNT1 A 0
		TNT1 A 0 A_MonsterRefire(64, "ChasePlayer")
		TNT1 A 0 A_JumpIfInTargetInventory("PlayerIsDead", 1, "Laugh")
		Goto MissileContinue
		
	Pain:
		PLA3 G 3 A_Pain
		//TNT1 A 0 A_Jump(192, "RollLeft", "RollRight")
		PLA3 G 3
		Goto ChasePlayer

	Pain.Avoid:
		TNT1 A 0
		//TNT1 A 0 A_Jump(192, "RollLeft", "RollRight")
		Goto Jump

	RollLeft:
		TNT1 A 0
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+192, 10, 0, 0)
		PROL EDCBA 3
		TNT1 A 0 A_CheckSight("See")
		Goto Missile

	RollRight:
		TNT1 A 0
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+64, 10, 0, 0)
		PROL ABCDE 3
		TNT1 A 0 A_CheckSight("See")
		Goto Missile

	Laugh:
		TNT1 A 0 A_FaceTarget
		//TNT1 A 0 A_PlaySound("EVMRLAUG")
		//PLA6 G 30
		Goto Idle

	Death.ExtremeKicks:
	Death.ExtremePunches:
		TNT1 A 0
		//TNT1 A 0 A_JumpIfInTargetInventory("HeavyStrikeRight", 1, "HeavyPunchRight")
		//TNT1 A 0 A_JumpIfInTargetInventory("HeavyStrikeLeft", 1, "HeavyPunchLeft") 
		//TNT1 A 0 A_JumpIfInTargetInventory("HeavyStrikeUpper", 1, "HeavyPunchUpper")
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_CustomMissile ("ExtremePunchedEvilMarine", 8, 0, random (175, 185), 2, random (10, 20))
		Stop
	}
}

Actor EvilMarineRocket: EvilMarineRifle
{
	DropItem "RocketAmmo"
	States
	{
	Idle:
		PL5S AAAAAAA 5 A_Look
		TNT1 A 0 A_Jump(32, 3)
		TNT1 A 0 A_SetAngle(angle - 40)
		PL5S AA 5 A_Look
		TNT1 A 0 A_SetAngle(angle + 40)
		PL5S A 5 A_Look
		TNT1 A 0 A_Jump(32, 3)
		TNT1 A 0 A_SetAngle(angle + 40)
		PL5S AAAA 5 A_Look
		TNT1 A 0 A_SetAngle(angle - 40)
		PL5S AAA 5 A_Look
		TNT1 A 0 A_Recoil(-2)
		PL5S BBBB 2 A_Wander
		TNT1 A 0 A_Look
		TNT1 A 0 A_Recoil(-2)
		PL5S CCCC 2 A_Wander
		TNT1 A 0 A_Look
		TNT1 A 0 A_Recoil(-2)
		PL5S DDDD 2 A_Wander
		TNT1 A 0 A_Look
		TNT1 A 0 A_Recoil(-2)
		PL5S AAAA 2 A_Wander
		TNT1 A 0 A_Look
		TNT1 A 0 A_Recoil(-2)
		PL5S BBBB 2 A_Wander
		TNT1 A 0 A_Look
		TNT1 A 0 A_Recoil(-2)
		PL5S CCCC 2 A_Wander
		TNT1 A 0 A_Look
		Loop

	Spawn:
		PL5S A 2
		PL5S A 0 ACS_NamedExecuteWithResult("EvilMarine_Wad_Patches",0,0,0,0)
		PL5S A 1
		Goto Stand

	Stand:
		PL5S A 5 A_Look
		Loop

	See:
		TNT1 A 0
		Goto ChasePlayer

	ChasePlayer:
		PL5S AA 1 A_Chase("","")
		TNT1 A 0 A_JumpIfInventory("evmarinenoway", 1, "CheckifCanJump")
		PL5S AA 1 A_Chase//("","")
		TNT1 A 0 A_Recoil(-2)
		PL5S BBBB 1 A_Chase
		TNT1 A 0 A_Recoil(-2)
		PL5S CCCC 1 A_Chase
		TNT1 A 0 A_Recoil(-2)
		PL5S DDD 1 A_Chase
		TNT1 A 0 A_CustomMissile("EvilMarineCheckFront", 32, 0, 0, 2, 0)
		PL5S D 1
		TNT1 A 0 A_CustomMissile("EvilMarineCheckJump", 64, 0, 0, CMF_AIMDIRECTION, 35)
		Loop

	CHeckIfCanJump:
		PL5S A 2
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_TakeInventory("evmarinenoway", 1)
		TNT1 A 0 A_JumpIfInventory("evmarinecanjump", 1, "Jump")
		Goto ChasePlayer+5

	Missile:
		TNT1 A 0
		TNT1 A 0 A_Jump(192, "MissileLeft", "MissileRight")
		PL5S E 15 A_FaceTarget
		PL5S E 3 BRIGHT A_PlaySound ("Rocket/Fire")
		TNT1 A 0 A_CustomMissile("Rocket",32,0,0,0)
		TNT1 A 0 A_Recoil(5)
		PL5S E 15 A_FaceTarget
		TNT1 A 0 A_JumpIfInTargetInventory("PlayerIsDead", 1, "Laugh")
		Goto ChasePlayer

	MissileLeft:
		TNT1 A 0
		PL5S E 10 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+192, 9, 0, 0)
		PL5S E 15 A_FaceTarget
		PL5S E 3 BRIGHT A_PlaySound ("Rocket/Fire")
		TNT1 A 0 A_CustomMissile("Rocket",32,0,0,0)
		TNT1 A 0 A_Recoil(5)
		PL5S E 15 A_FaceTarget
		TNT1 A 0 A_JumpIfInTargetInventory("PlayerIsDead", 1, "Laugh")
		Goto ChasePlayer

	MissileRight:
		TNT1 A 0
		PL5S E 10 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+64, 9, 0, 0)
		PL5S E 15 A_FaceTarget
		PL5S E 3 BRIGHT A_PlaySound ("Rocket/Fire")
		TNT1 A 0 A_CustomMissile("Rocket",32,0,0,0)
		TNT1 A 0 A_Recoil(5)
		PL5S E 15 A_FaceTarget
		TNT1 A 0 A_JumpIfInTargetInventory("PlayerIsDead", 1, "Laugh")
		Goto ChasePlayer

	Jump:
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("evmarinecanjump", 1)
		TNT1 A 0 ThrustThingZ(0, 50, 0, 1)
		MAR5 J 1
		TNT1 A 0 A_Recoil(-6)
		MAR5 J 10
		TNT1 A 0 A_CheckSight("WaitforLand")
		MAR5 J 2 A_Facetarget
		MAR5 J 3 BRIGHT A_PlaySound ("Rocket/Fire")
		TNT1 A 0 A_CustomMissile("Rocket",32,0,0,0)
		TNT1 A 0 A_Recoil(5)
	WaitforLand:
		TNT1 A 0 A_Recoil(-4)
		MAR5 JJJJJJJJJJJJJJJJJ 4 A_Checkfloor("ChasePlayer")
		TNT1 A 0 A_JumpIfInTargetInventory("PlayerIsDead", 1, "Laugh")
		Goto ChasePlayer

	Pain:
		PL5S G 3 A_Pain
		TNT1 A 0 A_Jump(192, "RollLeft", "RollRight")
		PL5S G 3
		Goto ChasePlayer

	Pain.Avoid:
		TNT1 A 0
		TNT1 A 0 A_Jump(192, "RollLeft", "RollRight")
		Goto Jump

	RollLeft:
		TNT1 A 0
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+192, 10, 0, 0)
		PROL EDCBA 3
		TNT1 A 0 A_CheckSight("See")
		Goto Missile

	RollRight:
		TNT1 A 0
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+64, 10, 0, 0)
		PROL ABCDE 3
		TNT1 A 0 A_CheckSight("See")
		Goto Missile

	Laugh:
		TNT1 A 0 A_FaceTarget
		//TNT1 A 0 A_PlaySound("EVMRLAUG")
		//PLA6 G 30
		Goto Idle

	Death.ExtremeKicks:
	Death.ExtremePunches:
		TNT1 A 0
		//TNT1 A 0 A_JumpIfInTargetInventory("HeavyStrikeRight", 1, "HeavyPunchRight")
		//TNT1 A 0 A_JumpIfInTargetInventory("HeavyStrikeLeft", 1, "HeavyPunchLeft") 
		//TNT1 A 0 A_JumpIfInTargetInventory("HeavyStrikeUpper", 1, "HeavyPunchUpper")
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_CustomMissile ("ExtremePunchedEvilMarine", 8, 0, random (175, 185), 2, random (10, 20))
		Stop
	}
}

