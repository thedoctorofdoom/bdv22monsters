Actor FormerMarine: EvilMarineRifle
{
	SeeSound "grunt/sight"
	PainSound "grunt/pain"
	DeathSound "grunt/death"
	ActiveSound "grunt/active"
	Health 100
	Obituary "$OB_FORMERMARINE"
	Tag "$TAGBD_FORMERMARINE"
	DropItem "Clip"
	Speed 8
	States
	{
	See:
		PLAY  AA 1 A_Chase
		TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
		PLAY AA 2 A_Chase
		TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
		PLAY BB 2 A_Chase
		TNT1 B 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
		PLAY BB 2 A_Chase
		TNT1 A 0 A_SpawnItemEx("FootStep", 0, 0, 20, 0, 0)
		TNT1 B 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
		PLAY CC 2 A_Chase
		TNT1 C 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
		PLAY DD 2 A_Chase
		TNT1 D 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
		PLAY BB 2 A_Chase
		TNT1 B 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
		PLAY BB 2 A_Chase
		TNT1 A 0 A_SpawnItemEx("FootStep", 0, 0, 20, 0, 0)
		TNT1 B 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
		Goto See

	Missile:
		TNT1 A 0
		PLAY E 10 A_FaceTarget
		PLAY F 2 BRIGHT A_PlaySound("Rifle/Fire")
		TNT1 A 0 A_SpawnItem ("RifleCaseSpawn", 0, 30,0)
		TNT1 A 0 A_CustomMissile("ZombiemanTracer",35,0,0,0)
		PLAY E 2 A_Facetarget
		PLAY F 2 BRIGHT A_PlaySound("Rifle/Fire")
		TNT1 A 0 A_SpawnItem ("RifleCaseSpawn", 0, 30,0)
		TNT1 A 0 A_CustomMissile("ZombiemanTracer",35,0,0,0)
		PLAY E 2 A_Facetarget
		PLAY F 2 BRIGHT A_PlaySound("Rifle/Fire")
		TNT1 A 0 A_SpawnItem ("RifleCaseSpawn", 0, 30,0)
		TNT1 A 0 A_CustomMissile("ZombiemanTracer",35,0,0,0)
		PLAY E 2 A_Facetarget
		PLAY F 2 BRIGHT A_PlaySound("Rifle/Fire")
		TNT1 A 0 A_SpawnItem ("RifleCaseSpawn", 0, 30,0)
		TNT1 A 0 A_CustomMissile("ZombiemanTracer",35,0,0,0)
		PLAY E 6 A_Facetarget
		Goto SEE

	Pain:
	Pain.Avoid:
		PLAY G 3 A_Pain
		PLAY G 3
		Goto See
	}
}

Actor EvilMarineShotgun: EvilMarineRifle
{
	DropItem "Shotgun"
	Translation "48:79=[255,203,155]:[75,58,24]",  "112:127=[61,146,61]:[11,12,10]"
	States
	{
	Idle:
		PLA3 AAAAAAA 5 A_Look
		TNT1 A 0 A_Jump(32, 3)
		TNT1 A 0 A_SetAngle(angle - 40)
		PLA3 AA 5 A_Look
		TNT1 A 0 A_SetAngle(angle + 40)
		PLA3 A 5 A_Look
		TNT1 A 0 A_Jump(32, 3)
		TNT1 A 0 A_SetAngle(angle + 40)
		PLA3 AAAA 5 A_Look
		TNT1 A 0 A_SetAngle(angle - 40)
		PLA3 AAA 5 A_Look
		TNT1 A 0 A_Recoil(-2)
		PLA3 BBBB 2 A_Wander
		TNT1 A 0 A_Look
		TNT1 A 0 A_Recoil(-2)
		PLA3 CCCC 2 A_Wander
		TNT1 A 0 A_Look
		TNT1 A 0 A_Recoil(-2)
		PLA3 DDDD 2 A_Wander
		TNT1 A 0 A_Look
		TNT1 A 0 A_Recoil(-2)
		PLA3 AAAA 2 A_Wander
		TNT1 A 0 A_Look
		TNT1 A 0 A_Recoil(-2)
		PLA3 BBBB 2 A_Wander
		TNT1 A 0 A_Look
		TNT1 A 0 A_Recoil(-2)
		PLA3 CCCC 2 A_Wander
		TNT1 A 0 A_Look
		Loop

	Spawn:
		PLA3 A 2
		PLA3 A 0 ACS_NamedExecuteWithResult("EvilMarine_Wad_Patches",0,0,0,0)
		PLA3 A 1
		Goto Stand

	Stand:
		PLA3 A 5 A_Look
		Loop

	See:
		TNT1 A 0
		Goto ChasePlayer

	ChasePlayer:
		PLA3 AA 1 A_Chase("","")
		TNT1 A 0 A_JumpIfInventory("evmarinenoway", 1, "CheckifCanJump")
		PLA3 AA 1 A_Chase//("","")
		TNT1 A 0 A_Recoil(-2)
		PLA3 BBBB 1 A_Chase
		TNT1 A 0 A_Recoil(-2)
		PLA3 CCCC 1 A_Chase
		TNT1 A 0 A_Recoil(-2)
		PLA3 DDD 1 A_Chase
		TNT1 A 0 A_CustomMissile("EvilMarineCheckFront", 32, 0, 0, 2, 0)
		PLA3 D 1
		TNT1 A 0 A_CustomMissile("EvilMarineCheckJump", 64, 0, 0, CMF_AIMDIRECTION, 35)
		Loop

	CHeckIfCanJump:
		PLA3 A 2
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_TakeInventory("evmarinenoway", 1)
		TNT1 A 0 A_JumpIfInventory("evmarinecanjump", 1, "Jump")
		Goto ChasePlayer+5

	Missile:
		TNT1 A 0
		TNT1 A 0 A_Jump(192, "MissileLeft", "MissileRight")
		PLA3 E 10 A_FaceTarget
		PLA3 F 3 BRIGHT A_PlaySound("Shotgun/Fire")
		TNT1 AAAAA 0 A_CustomMissile("ShotgunguyTracer", 36, 0, random(-9, 9), 6, random(-9, 9))
		TNT1 A 0 A_Recoil(1)
		PLA3 H 4
		PLA3 E 6 A_FaceTarget
	Pump:	
		PLA3 J 6
		TNT1 A 0 A_PlaySound("Shotgun/Pump")
		PLA3 K 6 A_SpawnItem ("ShotCaseSpawn", 0, 30,0)
		PLA3 J 6
		TNT1 A 0 A_JumpIfInTargetInventory("PlayerIsDead", 1, "Laugh")
		Goto ChasePlayer

	MissileLeft:
		TNT1 A 0
		PLA3 E 5 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+192, 9, 0, 0)
		PLA3 F 3 BRIGHT A_PlaySound("Shotgun/Fire")
		TNT1 AAAAA 0 A_CustomMissile("ShotgunguyTracer", 36, 0, random(-9, 9), 6, random(-9, 9))
		TNT1 A 0 A_Recoil(1)
		PLA3 H 4
		PLA3 E 5 A_FaceTarget
		Goto Pump

	MissileRight:
		TNT1 A 0
		PLA3 E 5 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+64, 9, 0, 0)
		PLA3 F 3 BRIGHT A_PlaySound("Shotgun/Fire")
		TNT1 AAAAA 0 A_CustomMissile("ShotgunguyTracer", 36, 0, random(-9, 9), 6, random(-9, 9))
		TNT1 A 0 A_Recoil(1)
		PLA3 H 4
		PLA3 E 5 A_FaceTarget
		Goto Pump

	Jump:
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("evmarinecanjump", 1)
		TNT1 A 0 ThrustThingZ(0, 50, 0, 1)
		MAR3 J 1
		TNT1 A 0 A_Recoil(-6)
		MAR3 J 10
		TNT1 A 0 A_CheckSight("WaitforLand")
		MAR3 J 2 A_Facetarget
		MAR3 J 3 BRIGHT A_PlaySound("Shotgun/Fire")
		TNT1 AAAAA 0 A_CustomMissile("ShotgunguyTracer", 36, 0, random(-9, 9), 6, random(-9, 9))
		TNT1 A 0 A_Recoil(1)
	WaitforLand:
		TNT1 A 0 A_Recoil(-4)
		MAR3 JJJJJJJJJJJJJJJJJ 4 A_Checkfloor("Pump")
		TNT1 A 0 A_JumpIfInTargetInventory("PlayerIsDead", 1, "Laugh")
		Goto Pump

	Pain:
		PLA3 G 3 A_Pain
		TNT1 A 0 A_Jump(192, "RollLeft", "RollRight")
		PLA3 G 3
		Goto ChasePlayer

	Pain.Avoid:
		TNT1 A 0
		TNT1 A 0 A_Jump(192, "RollLeft", "RollRight")
		Goto Jump

	RollLeft:
		TNT1 A 0
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+192, 10, 0, 0)
		PROL EDCBA 3
		TNT1 A 0 A_CheckSight("See")
		Goto Missile

	RollRight:
		TNT1 A 0
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+64, 10, 0, 0)
		PROL ABCDE 3
		TNT1 A 0 A_CheckSight("See")
		Goto Missile

	Laugh:
		TNT1 A 0 A_FaceTarget
		//TNT1 A 0 A_PlaySound("EVMRLAUG")
		//PLA6 G 30
		Goto Idle

	Death.ExtremeKicks:
	Death.ExtremePunches:
		TNT1 A 0
		//TNT1 A 0 A_JumpIfInTargetInventory("HeavyStrikeRight", 1, "HeavyPunchRight")
		//TNT1 A 0 A_JumpIfInTargetInventory("HeavyStrikeLeft", 1, "HeavyPunchLeft") 
		//TNT1 A 0 A_JumpIfInTargetInventory("HeavyStrikeUpper", 1, "HeavyPunchUpper")
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_CustomMissile ("ExtremePunchedEvilMarine", 8, 0, random (175, 185), 2, random (10, 20))
		Stop		
	}
}

