ACTOR ArmlessAlien
{
	Game Doom
	Radius 16
	Height 35
	Health 10
	PainChance 255
	damagefactor "Blood", 0.0 damagefactor "BlueBlood", 0.0 damagefactor "GreenBlood", 0.0 damagefactor "PurpleBlood", 0.0
	damagefactor "Avoid", 0.0
	damagefactor "Kick", 2.0
	DamageFactor "Trample" , 0.0
	bloodtype "Purple_Blood", "PurpleSawBlood", "PurpleSawBlood"
	BloodColor "Purple"	
	Mass 50
	-SOLID
	+SHOOTABLE
	+FLOORCLIP
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_SpawnItem ("PurpleBigBloodSpot")
		6AAG A 10
		Goto Suffer

	Suffer:
		6AAG BC 10 A_SpawnItem("PurpleBloodDying", 0, 20)
		TNT1 A 0 A_SpawnItem ("HeadshotTarget10", 0, 35,0)
		TNT1 A 0 A_PlaySound("alieno/pain",CHAN_VOICE)
		TNT1 A 0 A_GiveInventory("DeathTimer1", 1)
		TNT1 A 0 A_JumpIfInventory("DeathTimer1", 10, "GotoDeath")
		Loop

	GotoDeath:
		TNT1 A 0 A_ChangeFlag("INVULNERABLE", 1)
		TNT1 A 0
		TNT1 A 0 A_Die
		stop

	Death:
		TNT1 A 0 A_PlaySound("alieno/death")
		6AAG DEFGH 5
		6AAG I -1
		Stop

	Death.Head:
		TNT1 A 0 A_PlaySound("misc/xdeath4")
		TNT1 A 0 A_SpawnItem("AlienHeadExplode", 0, 50)
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_CustomMissile("Purple_LiquidBlood", 40, 0, random (0, 360), 2, random (60, 120))
		TNT1 A 0 A_XScream
		TNT1 A 0 A_SpawnItem ("HealthPlusFatalityBonus")
		TNT1 AAAAAAAAAAA 0 A_CustomMissile("Purple_Blood", 37, 0, random (0, 360), 2, random (0, 160))
		7AAG CDEG 4
		7AAG H -1
		Stop
	}
}


