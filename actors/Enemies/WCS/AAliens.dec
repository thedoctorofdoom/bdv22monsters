Actor AncientFlyingCunt
{
	Game Doom
	Monster 
	Radius 20
	Height 50
	Health 100
	Mass 1500
	Speed 6
	+FLOAT +NOGRAVITY +FORCEXYBILLBOARD +DONTFALL +NOBLOOD +DONTHARMSPECIES
	SeeSound "AlienGuard/See"
	PainSound "alieno/pain"
	ActiveSound "AlienGuardian/Loop"
	DeathSound "AlienGuard/Death"
	PainChance 128
	PainChance "Avoid", 192
	PainChance "Kick", 255
	PainChance "Avoid", 90
	PainChance "Saw", 255
	damagefactor "ExplosiveImpact", 3.0 damagefactor "Shrapnel", 3.0
	Damagefactor "GibRemoving", 0.0 damagefactor "HangingHook", 0
	damagefactor "TeleportRemover", 0.0
	DamageFactor "CauseSplash", 0.0 DamageFactor "CauseObjectsToSplashSlime", 0.0 DamageFactor "CauseObjectsToSplashNukage", 0.0
	DamageFactor "CauseObjectsToSplashBlood", 0.0 DamageFactor "CauseObjectsToSplashLava", 0.0
	Obituary "$OB_ANCIENTALIEN"
	Tag "$TAGBD_ANCIENTALIEN" 
	+USEKILLSCRIPTS
	States
	{
	Spawn:
		AAAG AABBCCDDEEFF 2 A_Look
		Loop

	See:
		AAAG AABBCCDDEEFF 2 A_CHASE
		Loop

	Missile:
		TNT1 A 0 A_Jump(96,"Avoid")
		TNT1 AAA 0
		A1AG A 3 A_FaceTarget
		A1AG B 7 A_FaceTarget
		A1AG c 4 BRIGHT A_CustomMissile("LessBullshittyRevenantMissile", 34, 0, 0, 0)
		A1AG B 7 A_FaceTarget
		A1AG c 4 BRIGHT A_CustomMissile("LessBullshittyRevenantMissile", 34, 0, 0, 0)
		A1AG B 7 A_FaceTarget
		A1AG c 4 BRIGHT A_CustomMissile("LessBullshittyRevenantMissile", 34, 0, 0, 0)
		A1AG A 3 A_FaceTarget
		Goto See

	Pain:
		A1AG D 3
		A1AG D 3 A_Pain
		Goto See

	Pain.Avoid: 
		TNT1 A 0
		TNT1 A 0 A_Jump(255, "AvoidLeft", "AvoidRight")
		Goto AvoidLeft
 
	AvoidLeft:
		a1ag A 1 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+192, 15, 0, 0)
		a1ag A 5 A_FaceTarget
		Goto Missile

	AvoidRight:
		a1ag A 1 A_FaceTarget
		TNT1 A 0 ThrustThing(angle*256/360+64, 15, 0, 0)
		a1ag A 5 A_FaceTarget
		Goto Missile

	Death:
		BARI A 0 a_ChangeFlag(DONTHARMSPECIES,false)
		AAAG G 1 A_Scream
		AAAG GH 4 BRIGHT
		AAAG I 4 BRIGHT
		TNT1 A 0 A_RadiusGive("BarrelExpMeasure", 300, RGF_GIVESELF | RGF_MONSTERS | RGF_CORPSES, 1)
		TNT1 A 0 A_SpawnItemEx ("BarrelExplosionDamage",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItemEx ("DetectFloorCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItemEx ("DetectCeilCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItemEx ("ExplosionFlareSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItem("WhiteShockwaveBig")
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 
		TNT1 A 0 A_SpawnItemEx ("BarrelKaboom",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 AAAA 0 A_CustomMissile ("FireworkSFXType2", 64, 0, random (0, 360), 2, random (30, 60))
		TNT1 AAA 0 A_CustomMissile ("HighExplosiveFlames", random (10, 20), 0, random (0, 360), 2, random (10, 90))
		EXPL AA 0 A_CustomMissile ("BigBlackSmokeLarger", 20, 0, random (0, 360), 2, random (10, 90))
		TNT1 AAA 0 A_CustomMissile ("BDExplosionparticles3", 64, 0, random (0, 360), 2, random (40, 90))
		TNT1 AAA 0 A_CustomMissile ("BDExplosionparticles4", 64, 0, random (0, 360), 2, random (40, 90))
		EXPL A 0 Radius_Quake (2, 24, 0, 15, 0)
		BEXP B 0 BRIGHT A_Scream
		TNT1 AA 0 A_CustomMissile ("BarrelShrapnel1", 25, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile ("BarrelShrapnel2", 15, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile ("BarrelShrapnel3", 5, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile ("BarrelShrapnel4", 5, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_PlaySound("FAREXPL", 3)
		TNT1 AA 0 A_SpawnItemEx("TinyBurningPiece", random (-15, 15), random (-15, 15))
		TNT1 AA 0 A_SpawnItemEx("TinyBurningPiece2", random (-35, 35), random (-35, 35))
		TNT1 AA 0 A_SpawnItemEx("TinyBurningPiece3", random (-45, 45), random (-45, 35))
		TNT1 A 4
		TNT1 A 0 A_SpawnItemEx ("ExplosionSplashSpawner", 0, 0, 0)
		TNT1 AAA 8 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (50, 130))
		BEXP Z 300 BRIGHT A_BarrelDestroy
		BEXP Z 5 A_Respawn
		Stop
	}
}

Actor InvisibleAlien //UNAlien......why?
{
	Game Doom
	Health 30
	Monster
	GibHealth 10
	Radius 20
	Height 56
	Mass 100
	Speed 10
	PainSound "alieno/pain"
	DeathSound "alieno/death"
	ActiveSound "Alieno/Attivo"
	SeeSound "alieno/sight"
	Obituary "$OB_INVISIBLEALIEN"
	Tag "$TAGBD_INVISIBLEALIEN"	
	PainChance 200
	bloodtype "Purple_Blood", "PurpleSawBlood", "PurpleSawBlood"
	BloodColor "Purple"
	+FLOORCLIP
	+SLIDESONWALLS
	+MISSILEMORE
	+DONTHARMSPECIES
	DropItem "Clip"
	+Solid
	DamageFactor "ExtremePunches", 2.0 DamageFactor "ExtremeKicks", 2.0
	DropItem "None"
	pAINcHANCE "Kick",256
	PainChance "Melee", 255 PainChance "Stealth", 255
	MaxStepHeight 24
	MaxDropOffHeight 32
	///New Damage Factors
	damagefactor "Crush", 5.0 DamageFactor "Fatality", 5.0 damagefactor "FallInLava", 500.0
	damagefactor "Avoid", 0.0
	damagefactor "DontCallTheBaron", 0.0 damagefactor "PussyGrab", 50.0
	damagefactor "TeleportRemover", 0.0
	damagefactor "GibRemoving", 0.0
	damagefactor "SSG", 500.0
	DamageFactor "Head", 1.3
	damagefactor "Melee", 1.35
	damagefactor "Shotgun", 2.0
	damagefactor "Blood", 0.0 damagefactor "BlueBlood", 0.0 damagefactor "GreenBlood", 0.0  damagefactor "PurpleBlood", 0.0 
	DamageFactor "CauseSplash", 0.0 DamageFactor "CauseObjectsToSplashSlime", 0.0 DamageFactor "CauseObjectsToSplashNukage", 0.0
	DamageFactor "CauseObjectsToSplashBlood", 0.0 DamageFactor "CauseObjectsToSplashLava", 0.0
	DamageFactor "Taunt" , 0.0 
	+USEKILLSCRIPTS
	States
	{
	Spawn:
	Stand:
		TNT1 A 0
		TNT1 A 0 A_CheckSight("Stand2")
		//TNT1 AA 0 A_SpawnItem ("HeadshotTarget20", 0, 40,0)
		A6AG AA 11 A_Look
		Loop

	Stand2:
		A6AG AA 11 A_Look
		TNT1 A 0 A_CheckSight("Stand2")
		Goto Stand

	See:
		A6AG AA 1 A_Chase
		A6AG AA 2 A_Chase
		A6AG bb 2 A_Chase
		A6AG BB 2 A_Chase
		TNT1 A 0 A_SpawnItemEx("FootStep", 0, 0, 20, 0, 0)
		A6AG CC 2 A_Chase
		AACA CC 2 A_Chase
		A6AG DD 2 A_Chase
		A6AG DD 2 A_Chase
		TNT1 A 0 A_SpawnItemEx("FootStep", 0, 0, 20, 0, 0)
		Goto See

	Missile:
	Missile3:
		AACA B 5 
		AACA C 5 A_FaceTarget
		AACA C 5 A_FACETARGET
		AACA D 2 BRIGHT A_CustomMissile("AAEnemyPlasmaBall", 28, 0,0, 1)
		AACA C 1 
		AACA C 2 A_FaceTarget
		AACA D 2 BRIGHT A_CustomMissile("AAEnemyPlasmaBall", 28, 0,0, 1)
		TNT1 A 0 
		AACA C 1  
		AACA C 2 A_FaceTarget
		AACA B 5 
		Goto See

	Pain.ExplosiveImpact:
	Pain.Explosive:
		TNT1 A 0
		TNT1 A 0 A_Pain
		TNT1 A 0 A_JumpIfInventory ("IsDown", 1, "Pain")
		TNT1 A 0 A_TakeInventory("SKZombieman", 1)
		TNT1 A 0 A_GiveInventory("IsDown", 1)
		TNT1 A 0 ThrustThingZ(0,40,0,1)
		2AAG ABCDE 5
		Goto FallingAfterImpact
	Pain.Kick:
	Pain.Stomp:
	Pain.HeavyImpact:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("NOBLOCKMONST", 1)
		TNT1 A 0 A_ChangeFLag("NODROPOFF", 0)
		TNT1 A 0 A_ChangeFlag("NOPAIN", 1)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 1)
		2AAG A 0 A_Pain
		TNT1 A 0 A_ChangeFlag("NOPAIN", 0)
		TNT1 A 0 A_ChangeFlag("GHOST", 1)
		TNT1 A 0 A_ChangeFlag("THRUGHOST", 1)
		TNT1 A 0 A_ChangeFlag("FORCEXYBILLBOARD", 1)
		TNT1 A 0 A_JumpIfInventory ("IsDown", 1, "Pain")
		TNT1 A 0 A_TakeInventory("SKZombieman", 1)
		2AAG A 1 A_facetarget
		TNT1 A 0 ThrustThingZ(0,30,0,1)
		TNT1 A 0 A_FaceTarget
		2AAG A 3 ThrustThing(angle*256/360+128, 10, 0, 0)
		TNT1 A 0 A_GiveInventory("IsDown", 1)
		TNT1 A 0 ThrustThingZ(0,40,0,1)
		2AAG ABCD 3
		TNT1 A 0 A_ChangeFlag("GHOST", 0)
		TNT1 A 0 A_ChangeFlag("THRUGHOST", 0)
		Goto FallingAfterImpact

	FallingAfterImpact:
		2AAG E 1 A_GiveInventory ("FallingHeight", 1)
		2AAG E 1 A_CheckFloor("GetUp")
		NULL B 0 A_JumpIf (momz == 0, "GetUp")
		Loop

	GetUp:
		TNT1 A 0
		MARN A 0 A_SpawnItem("bdbodythud")
		TNT1 A 0 A_JumpIfInventory ("FallingHeight", 5, "FallingDie")
		2AAG F 5
		TNT1 A 0 A_TakeInventory("FallingHeight", 100)
		TNT1 A 0 A_Stop
		2AAG FFFFFFFFFF 5 A_JumpIf(momz < 0, "FallingAfterImpact")
		TNT1 A 0 A_TakeInventory("IsDown", 1)
		TNT1 A 0 A_ChangeFlag("GHOST", 0)
		TNT1 A 0 A_ChangeFlag("THRUGHOST", 0)
		2AAG G 10
		TNT1 A 0 A_ChangeFlag("FORCEXYBILLBOARD", 0)
		Goto See

	FallingDie:
		TNT1 A 0
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CustomMissile("BodyCrash1", 10)
		Goto Getup+8

	Pain:
		TNT1 A 0 A_JumpIfInventory("IsDown", 1, 6)
		AACA F 3 A_Pain
		AACA F 3
		TNT1 A 0
		Goto See
		TNT1 AAAA 0
		TNT1 A 0 A_Pain
		TNT1 A 0 A_ChangeFlag("SPECTRAL", 0)
		TNT1 A 0 A_TAkeInventory("BarrelExpMeasure", 100)
		2AAG E 8
		Goto GetUp+2

	Death.Kick:
	Death:
		TNT1 A 0 A_CustomMissile ("MuchBloodPurple", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_JumpIfInventory ("IsDown", 1, "Death.Low")
		tNT1 A 0 A_Jump(32, "Death.Arm", "Death.Leg")
		AACA F 4
		AACA G 4 A_Scream
		AACA H 4 A_NoBlocking
		AACA I 4 
		TNT1 A 0 A_SpawnItem ("PurpleGrowingBloodPool")
		AACA J -1
		Stop

	Death.Low:
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 
		TNT1 A 0 A_SpawnItem ("PurpleGrowingBloodPool")
		AACA J -1
		Stop

	Death.Minigun:
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_SpawnItem("MuchBlood2Purple", 0, 40)
		TNT1 A 0 A_SpawnItem("AlienDeath")
		STOP

	XDeath:
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_CustomMissile ("AlienXdeath", 0, 0, random (0, 360), 2, random (0, 160))
		TNT1 AAAA 0 A_CustomMissile ("MuchBlood2Purple", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 AAA 0 A_CustomMissile ("MuchBloodPurple", 50, 0, random (0, 360), 2, random (0, 160))
		Stop

	Death.ExplosiveImpact:
		TNT1 A 0
		TNT1 A 0 A_NoBlocking
		/*TNT1 AAAA 0 A_CustomMissile("Brains1", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile("Brains2", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile("Brains3", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile("Brains4", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile("Brains5", 50, 0, random (0, 360), 2, random (0, 160))*/
		TNT1 AAAA 0 A_CustomMissile("SmallPurpleBrainPiece", random (45, 55), random (5, -5), random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile("SmallPurpleBrainPiece", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 AA 0 A_CustomMissile ("SuperWallPurpleBlood", 46, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAAAAAAAAA 0 A_CustomMissile ("Purple_Blood", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile("AlienHeadExplode", 35, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile("XDeath3Purple", 40, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile("XDeathAlienLeg", 32, 0, random (0, 360), 2, random (0, 160))
		TNT1 AAAA 0 A_CustomMissile ("XDeath1Purple", 40, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 ThrustThingZ(0,30,0,1)
		8AAG ABCDEFG 3 
		8AAG HHH 3 A_CheckFloor("Death.ExplosiveImpact2")
		8AAG HHHH 3 A_CheckFloor("Death.ExplosiveImpact2")
		TNT1 A 0 A_SpawnItem("PurpleGrowingBloodPool")
		8AAG J -1
		Stop

	Death.ExplosiveImpact2:
		8AAG I 3
		TNT1 A 0 A_SpawnItem("PurpleGrowingBloodPool")
		8AAG J -1
		Stop

	Death.Leg:
		TNT1 A 0 A_CustomMissile("XDeathAlienLeg", 35, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_CustomMissile("MuchBloodPurple", 10, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_Pain
		5aag a 3 A_NoBlocking
		TNT1 A 0 A_SpawnItemEx("ArmlessAlien2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		Stop

	Death.Arm:
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_CustomMissile("AlienArm", 35, 0, random (0, 360), 2, random (0, 160))
		6AAG A 5 A_CustomMissile("XDeath1Purple", 40, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_SpawnItem("PurpleGrowingBloodPool")
		TNT1 A 0 A_SpawnItemEx("ArmlessAlien",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		Stop

	Death.Head:
		TNT1 A 0
		TNT1 A 0 A_XScream
		TNT1 A 0 A_SpawnItem("AlienHeadExplode", 0, 50)
		TNT1 A 0 A_NoBlocking
		3AAG AA 2 A_CustomMissile("Purple_LiquidBlood", 40, 0, random (0, 360), 2, random (60, 120))
		TNT1 A 0 A_FaceTarget
		3AAG BBBBBBBBBBBB 2
		3AAG CCDDEE 2
		TNT1 A 0 A_SpawnItem ("PurpleGrowingBloodPool")
		3AAG E -1 
		Stop

	Death.MonsterShotgunBullet:
	Death.Shotgun:
		TNT1 A 0 A_SpawnItem("MuchBloodPurple", 0, 40)
		TNT1 A 0 A_CustomMissile("SuperWallPurpleBlood", 42, 0, random (170, 190), 2, random (0, 20))
		TNT1 A 0 A_Jump(42, "Death.Shotgunontheface")
		TNT1 A 0 A_JumpIfCloser(100, "Death.Blast")
		TNT1 A 0 A_JumpIfCloser(320, "Death.Shotgunontheface")
		Goto Death

	Death.Shotgunontheface:
	Death.HeavyImpact:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("SLIDESONWALLS", 0)
		TNT1 A 0 A_Jump(24, "Death.ARm")
		TNT1 A 0 A_Jump(128, "DeathAlienFly")
		TNT1 A 0 A_ChangeFlag("NOBLOCKMONST", 1)
		TNT1 A 0 A_Jump(96, "Death.Blast")
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 
		TNT1 A 0 A_Stop
		TNT1 A 0 A_Pain
		TNT1 A 0 A_Recoil(13)
		TNT1 A 0 ThrustThingZ(0,20,0,1)
		TNT1 A 0 A_Scream
		TNT1 AA 0 A_CustomMissile("XDeath1Purple", 35, 0, random (0, 360), 2, random (0, 160))
		4AAG ABCD 4
		4AAG EFGHIJ 4 A_JumpIf((MomY == 0), "DSFStop")
		Goto DSFStop+1

	DSFStop:
		TNT1 A 0 A_SpawnItem("Ploft3")
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SpawnItem("PurpleGrowingBloodPool")
		TNT1 A 0 A_CustomMissile("SuperWallPurpleBlood", 2, 0, random (170, 190), 2, random (0, 0))
		4AAG J -1
		Stop

	DeathAlienFly:
		TNT1 A 0 A_ChangeFLag("NODROPOFF", 0)
		TNT1 A 0 A_ChangeFLag("SLIDESONWALLS", 0)
		TNT1 A 0 ThrustThingZ(0,30,0,1)
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_Recoil (6)
		2AAG A 5 A_CustomMissile ("Purple_LiquidBlood", 15, 0, random (0, 360), 2, random (0, 40))
		2AAG B 5 A_CustomMissile ("Purple_LiquidBlood", 15, 0, random (0, 360), 2, random (0, 40))
		2AAG C 5 A_CustomMissile ("Purple_LiquidBlood", 15, 0, random (0, 360), 2, random (0, 40))
		2AAG D 5 A_CustomMissile ("Purple_LiquidBlood", 15, 0, random (0, 360), 2, random (0, 40))
		2AAG E 5 A_CustomMissile ("Purple_LiquidBlood", 15, 0, random (0, 360), 2, random (0, 40))
		2AAG F 5 A_CustomMissile ("Purple_LiquidBlood", 15, 0, random (0, 360), 2, random (0, 40))
		TNT1 A 0 A_SpawnItem("PurpleGrowingBloodPool")
		AACA J -1
		Stop

	Death.Blast:
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_CustomMissile ("AlienArm", 42, 0, random (0, 360), 2, random (0, 40))
		TNT1 AAA 0 A_CustomMissile ("PurpleGuts", 32, 0, random (150, 210), 2, random (0, 40))
		TNT1 A 0 A_CustomMissile ("AlienHead", 32, 0, random (150, 210), 2, random (0, 40))
		TNT1 AAA 0 A_CustomMissile ("XDeath1Purple", 32, 0, random (150, 210), 2, random (0, 40))
		TNT1 AAA 0 A_CustomMissile ("XDeath3Purple", 16, 0, random (170, 190), 2, random (0, 40))
		TNT1 AA 0 A_CustomMissile ("XDeath2Purple", 16, 0, random (130, 210), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Purple_FlyingBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Purple_FlyingBloodFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Purple_FlyingBloodMuchFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AA 0 A_CustomMissile ("SuperWallPurpleBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAA 0 A_CustomMissile ("PurpleBloodMistBig", 40, 0, random (0, 360), 2, random (30, 90))
		TNT1 AAA 0 A_CustomMissile ("PurpleBloodMist", 40, 0, random (0, 360), 2, random (40, 90))
		7AAG A 6 A_Stop
		TNT1 A 0 A_SpawnItem("ArmlessAlien3")
		TNT1 A -1
		Stop

	Death.Railgun:
	Death.SSG:
		1AAG S 1 A_Pain
		TNT1 A 0 A_SpawnItem("MuchBlood2Purple", 0, 40)
		1AAG S 1 A_FaceTarget
		TNT1 AAA 0 bright A_CustomMissile ("PurpleSuperGoreSpawner", 35, 0, random (170, 190), 2, random (0, 40))
		//TNT1 A 0 A_CustomMissile ("MeatDeath", 0, 0, random (0, 360), 2, random (0, 160))
		TNT1 AAAA 0 A_CustomMissile ("XDeath1Purple", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_CustomMissile ("XDeath2Purple", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_CustomMissile ("XDeath3Purple", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Purple_FlyingBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAA 0 A_CustomMissile ("PurpleGuts", 32, 0, random (150, 210), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Purple_FlyingBloodFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Purple_FlyingBloodMuchFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallPurpleBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallPurpleBlood", 46, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_CustomMissile ("AlienHead", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AA 0 A_CustomMissile ("AlienArm", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		1AAG STUVW 2
		TNT1 A 0 A_SpawnItem ("PurpleGrowingBloodPool")
		1AAG X -1 
		Stop

	Death.ExtremeKicks:
	Death.ExtremePunches:
		TNT1 A 0
