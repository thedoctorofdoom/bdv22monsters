		TNT1 AA 0 A_SpawnItemEx("TinyBurningPiece3", random (-45, 45), random (-45, 35))
		PBR2 CCDD 3 A_CustomMissile ("BluePlasmaFireNonStatic", 32, 0, random (0, 360), 2, random (0, 180))
		PBR2 EEFF 3
		PBR2 GG 3
		TNT1 A 0 A_GiveToTarget("SoulAmmo", 10)
		PBR2 H -1
		Stop

	XDeath.Plasma:
