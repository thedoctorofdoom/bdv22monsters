		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		XBRN GG 2 BRIGHT A_SpawnItem("BlueFlare",0,43)
		//TNT1 AAAA 0 A_CustomMissile ("PurpleBlood", 30, 0, random (0, 360), 2, random (0, 160))
