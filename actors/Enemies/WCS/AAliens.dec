		XBRN HH 2 BRIGHT A_SpawnItem("BlueFlare",0,43)
		//TNT1 A 0 A_CustomMissile ("PurpleBlood", 30, 0, random (0, 360), 2, random (0, 160))
		XBRN II 2 BRIGHT A_SpawnItem("BlueFlare",0,43)
