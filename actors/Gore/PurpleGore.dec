		TNT1 A 0 A_SpawnItemEx("XDeath3PurpleNoStick", 0, 0, 0, 0, 0, -1)
		XMT2 MMN 2
		stop
	}
}

//piece of meat that got stuck on the ceiling/wall and now is falling
ACTOR XDeath3PurpleNoStick: XDeath3NoStick
{
	translation "168:191=[255,255,255]:[128,0,255]", "16:47=[196,136,255]:[51,0,102]"
	Decal PurpleBloodSuper
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Splash")
		TNT1 A 0 A_CheckFloor("Death")
		XMT2 O 3
		Loop

	Death:
		TNT1 AAAAAAA 0 A_CustomMissile ("Purple_FlyingBloodTrail", 0, 0, random (0, 360), 2, random (20, 70))
		XMT2 I 1
		TNT1 A 0 A_QueueCorpse
		XMT2 I 3
		TNT1 A 0 A_SpawnItem("Purple_BloodSpot",0,0,0,1)
		XMT2 I -1
		Stop
	}
}

