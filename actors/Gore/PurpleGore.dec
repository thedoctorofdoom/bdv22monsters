//Spawns giant blood decals all around the area. Used in Purple Doom's BFG deaths.
Actor PurpleBloodSplinter
{
	+THRUACTORS
	+CLIENTSIDEONLY
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Splash")
		TNT1 A 0 A_CustomMissile ("GiantWallPurpleBlood", 40, 0, 0, 2, random (0, 35))
		TNT1 A 0 A_CustomMissile ("GiantWallPurpleBlood", 40, 0, 45, 2, random (0, 35))
		TNT1 A 0 A_CustomMissile ("GiantWallPurpleBlood", 40, 0, 90, 2, random (0, 35))
		TNT1 A 0 A_CustomMissile ("GiantWallPurpleBlood", 40, 0, 135, 2, random (0, 35))
		TNT1 A 0 A_CustomMissile ("GiantWallPurpleBlood", 40, 0, 180, 2, random (0, 35))
		TNT1 A 0 A_CustomMissile ("GiantWallPurpleBlood", 40, 0, 225, 2, random (0, 35))
		TNT1 A 0 A_CustomMissile ("GiantWallPurpleBlood", 40, 0, 270, 2, random (0, 35))
		TNT1 A 0 A_CustomMissile ("GiantWallPurpleBlood", 40, 0, 315, 2, random (0, 35))
		Stop

	Splash:
		BLOD A 0
		stop
	}
}

