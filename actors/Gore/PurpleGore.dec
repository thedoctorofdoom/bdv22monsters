/////////////////// CEILING BLOOD //////////////////////////

//Launches bloodspots on the ceiling
ACTOR PurpleCeilBloodLauncher: CeilBloodLauncher
{
	translation "168:191=[255,255,255]:[128,0,255]", "16:47=[196,136,255]:[51,0,102]"
	Decal PurpleBloodSplat
	States
	{
	Death:
		TNT1 A 0
		TNT1 A 0 A_CheckCeiling("IsOnCeil")
		TNT1 A 0
		stop
		
	IsOnCeil:
		TNT1 A 0
		TNT1 A 1 A_SpawnItem("PurpleCeilBloodSpot",0,0,0,1)
		Stop
	}
}

//Longer version (for extreme deaths)
ACTOR PurpleCeilBloodLauncherLong: PurpleCeilBloodLauncher
{
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Splash")
		TNT1 A 12
		Stop
	}
}

// The Ceil Blood Spot
actor PurpleCeilBloodSpot: CeilBloodSpot
{
	translation "168:191=[255,255,255]:[128,0,255]", "16:47=[196,136,255]:[51,0,102]"
	Decal PurpleBloodSplat
	states
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		BPDL A 1
		TNT1 A 0 A_QueueCorpse
		TNT1 A 0 A_SpawnItem ("DripingPurpleBloodLeavesSmallPool")
		TNT1 A 0 A_SpawnItem ("PurpleCeilBloodTinyBloodSpawner")
	Live:
		BPDL A 5 ThrustThingZ(0, 20, 0, 1)
		Loop
	}
}

