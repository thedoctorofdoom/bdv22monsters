//Gib actors

ACTOR XDeath1Purple: XDeath1
{
	translation "168:191=[255,255,255]:[128,0,255]", "16:47=[196,136,255]:[51,0,102]"
	Decal PurpleBloodSuper
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Underwater")
		BLOD AAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItem("Purple_LiquidBloodTrail")
		Stop

	Death:
		TNT1 A 0 A_SpawnItemEx ("Purple_BloodSpot", 0, 0, 1)
		TNT1 A 0 ACS_NamedExecuteAlways("BD_CheckIfOverLiquid")
		XDT1 EF 3
		TNT1 A 0 A_JumpIfInventory("IsOverWater", 1, "IsOverLiquid")
		TNT1 A 0 A_JumpIfInventory("IsOverSlime", 1, "IsOverLiquid")
		XDT1 GHIJKL 3
		Stop
		TNT1 A 1

	Underwater:
	Splash:
		BLUD C 0 ThrustThingZ (0,35,1,0)
		XDT1 AB 3 A_CustomMissile ("Purple_FlyingBloodTrail", 0, 0, random (0, 360), 2, random (0, 360))
		BLUD C 0 ThrustThingZ (0,35,1,0)
		XDT1 CD 3 A_CustomMissile ("Purple_FlyingBloodTrail", 0, 0, random (0, 360), 2, random (0, 360))
		Loop

	IsOverLiquid:
		TNT1 A 1
		TNT1 A 0 A_CheckFloor("SpawnOnWater")
	SpawnOnWater:
		TNT1 A 1
		TNT1 A 0 A_SpawnItem ("PurpleWaterBloodSpot", 5)
		Stop
	}
}

//A flying piece of meat
ACTOR XDeath2Purple: XDeath2
{
	translation "168:191=[255,255,255]:[128,0,255]", "16:47=[196,136,255]:[51,0,102]"
	Decal PurpleBloodSuper
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Splash")
		XMT1 ABCDEFGH 2 A_CustomMissile ("Purple_FlyingBloodTrail", 0, 0, random (0, 360), 2, random (0, 360))
		Loop

	Death:
		TNT1 AAAAAAA 0 A_CustomMissile ("Purple_FlyingBloodTrail", 0, 0, random (0, 180), 2, random (0, 180))
		TNT1 A 0 A_CheckFloor("SpawnFloor")
		TNT1 A 0 A_CheckCeiling("SpawnCeiling")
		TNT1 A 0 A_SpawnItem("SmearingXDeath2Purple")
		Stop

	SpawnFloor:
		XMT1 M 1
		TNT1 A 0 A_QueueCorpse
		TNT1 A 0 A_SpawnItemEx ("Purple_BloodSpot", 0, 0, 1)
		XMT1 M -1
		Stop

	SpawnCeiling:
		TNT1 A 0
		TNT1 A 0 A_SpawnItemEx ("CeilXDeath2Purple", 0, 0, 1)
		TNT1 A 0 A_SpawnItemEx ("PurpleCeilBloodSpotLarge", 0, 0, 1)
		Stop

	Vanish:
		TNT1 A 5
		Stop
	}
}

ACTOR XDeath2bPurple: XDeath2Purple {	Speed 4 } //Low-range version.

//A piece of meat that has hit the wall, and now is slowly smearing
ACTOR SmearingXDeath2Purple: SmearingXDeath2
{
	translation "168:191=[255,255,255]:[128,0,255]", "16:47=[196,136,255]:[51,0,102]"
	Decal PurpleBloodSuper
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		XMT1 N 10
		TNT1 A 0 ThrustThingZ(0, 1, 1, 1)
		TNT1 A 0 A_Jump(255, "Spawn1", "Spawn2", "Spawn3", "Spawn4")
	Spawn1:
		XMT1 NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN 2 A_CheckFloor("Rest")
		Goto Death

	Spawn2:
		XMT1 NNNNNNNNNNNNNNNNNNNNNNNN 2 A_CheckFloor("Rest")
		Goto Death

	Spawn3:
		XMT1 NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN 2 A_CheckFloor("Rest")
		Goto Death

	Spawn4:
		XMT1 NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN 2 A_CheckFloor("Rest")
		Goto Death

	Death:
		TNT1 A 0
		TNT1 A 0 A_SpawnItem("XDeath2PurpleNoStick")
		Stop

	Rest:
		XMT1 M 1
		TNT1 A 0 A_QueueCorpse
		TNT1 A 0 A_SpawnItem("Purple_BloodSpot",0,0,0,1)
		XMT1 M -1
		Stop

	Vanish:
		TNT1 A 5
		Stop
	}
}

//piece of meat that got stuck in the ceiling
actor CeilXDeath2Purple: CeilXdeath2
{
	translation "168:191=[255,255,255]:[128,0,255]", "16:47=[196,136,255]:[51,0,102]"
	Decal PurpleBloodSuper
	states
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0
		TNT1 A 0 A_JUmp (255, "Live1", "Live2", "Live3")
		Goto Live1

	Live1:
		XMT1 IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII 5 ThrustThingZ(0, 20, 0, 1)
		Goto Fall
		
	Live2:
		XMT1 IIIIIIIIIIIIIIIIIIIIIIIII 5 ThrustThingZ(0, 20, 0, 1)
		Goto Fall
		
	Live3:
		XMT1 IIIIIIIIIIIIIIIII 5 ThrustThingZ(0, 20, 0, 1)
		Goto Fall

	Fall:
		XMT1 F 0
		XMT1 JJJKKLL 2
		TNT1 A 0 A_SpawnItemEx("XDeath2PurpleNoStick", 0, 0, 0, 0, 0, -1)
		stop

	Splash:
		BLOD A 0
		stop
	}
}

