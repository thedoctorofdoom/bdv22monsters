{
	Speed 0
	+CLIENTSIDEONLY
	+NOINTERACTION
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0
		TNT1 A 0 A_stop
		TNT1 AAAA 2 A_CustomMissile ("Purple_LiquidBlood2", 0, 0, 0, 2, random (0, 60))
