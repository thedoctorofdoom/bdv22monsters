//Bloody footprints still requires the player to be edited to work.
//Gives the player an inventory item to indicate the feet are smeaPurple.
ACTOR BootSmearerPurple: BootSmearerRed
{
	states
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0
		TNT1 A 1 A_Look
		Goto See

	See:
		TNT1 A 1 A_Chase("","")
		TNT1 A 0 A_Die("LookForPlayer")
	Death:
	Death.LookForPlayer:
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 8 A_JumpIfCloser(60, "SmearBootsWithPurpleBlood")
		Stop

	SmearBootsWithPurpleBlood:
		TNT1 A 0 A_GiveToTarget("BootsSmearedWithPurpleBlood", 8)
		BPDL A 0
		Stop
	}
}

