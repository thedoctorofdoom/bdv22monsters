//These are the actors that spawns blood drips. They are separate from the bloodspots so the sticky gibs can spawn them separately.

//Small blood drips spawner, usually caused by regular blood touching the ceiling.
ACTOR PurpleCeilBloodTinyBloodSpawner: CeilBloodTinyBloodSpawner
{
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0
		TNT1 A 1 A_SpawnItemEx ("DripingPurpleBloodLeavesSmallPool", random (-5, 5), random (-5, 5), 0, 0, 0, -5)
		TNT1 AAAAAAAAAAAAAA 5 A_SpawnItemEx ("PurpleBloodDripingFromCeiling", random (-5, 5), random (-5, 5), 0, 0, 0, -5)
		TNT1 AAAAAAAAAAAAAA 10 A_SpawnItemEx ("PurpleBloodDripingFromCeiling", random (-5, 5), random (-5, 5), 0, 0, 0, -5)
		TNT1 AAAAAAAAAAAAAA 16 A_SpawnItemEx ("PurpleBloodDripingFromCeiling", random (-5, 5), random (-5, 5), 0, 0, 0, -5)
		TNT1 AAAAAAAAAAAAAA 24 A_SpawnItem ("PurpleBloodDripingFromCeiling")
		stop
	}
}

