//All the liquid gore stuff goes here.
//Hit puff actor
actor Purple_Blood: Brutal_Blood
{
	translation "168:191=[255,255,255]:[128,0,255]", "16:47=[196,136,255]:[51,0,102]"
	Decal PurpleBloodSplat
	states
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		BSPR A 0
		TNT1 A 0 A_CustomMissile ("PurpleSuperGoreMistTiny", 0, 0, random (0, 360), 2, random (0, 90))
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Splash")
		TNT1 A 0 ACS_NamedExecuteAlways("BD_CheckBloodIntensity")
		TNT1 A 0
		TNT1 A 0 A_PlaySound("misc/XDeath5Purple")
		BSPR A 2
		TNT1 A 0 A_CustomMissile ("PurpleWaterBloodCHecker", 7, 0, random (0, 360), 2, random (30, 60))
	Spawn2:
		TNT1 A 0 A_CustomMissile ("Purple_FlyingBlood", 7, 0, random (0, 360), 2, random (30, 60))
		TNT1 A 0 A_CustomMissile ("Purple_FlyingBloodTrail", 0, 0, random (0, 360), 2, random (20, 90))
		Goto LowBlood

	Splash:
		BLOD A 0
		TNT1 AAA 0 A_CustomMissile ("PurpleUnderblood1", 7, 0, random (0, 360), 2, random (30, 150))
		stop

	LotsOfBlood:
		TNT1 A 0
		TNT1 AAAA 0 A_CustomMissile ("PurpleBloodMistSmall", 0, 0, random (0, 360), 2, random (0, 90))
		TNT1 AAAAA 0 A_CustomMissile ("Purple_FlyingBlood", 7, 0, random (0, 360), 2, random (30, 70))
		TNT1 A 0 A_CustomMissile ("SuperWallPurpleBlood", 0, 0, random (0, 360), 2, random (-15, 15))
		TNT1 AAAA 0 A_CustomMissile ("Purple_FlyingBloodTrail", 0, 0, random (0, 360), 2, random (0, 90))
		Goto LowBlood

	AbsurdBlood:
		TNT1 A 2
		TNT1 AAAA 0 A_CustomMissile ("SuperWallPurpleBlood", 0, 0, random (0, 360), 2, random (-15, 15))
		TNT1 A 0 A_JumpIfInventory("AnimuGore", 1, "AnimuGore")
		TNT1 AA 0 A_CustomMissile ("PurpleBloodMist", 0, 0, random (0, 360), 2, random (0, 90))
		TNT1 AAA 0 A_CustomMissile ("Purple_FlyingBloodMuchFaster", 7, 0, random (0, 360), 2, random (10, 50))
		TNT1 A 0 A_CustomMissile ("Purple_FlyingBloodMuchFaster", 7, 0, random (0, 360), 2, random (40, 60))
		TNT1 A 0 A_CustomMissile ("PurpleBloodMistSmall", 7, 0, random (0, 360), 2, random (30, 90))
		TNT1 A 0 A_CustomMissile ("PurpleSuperGoreMist", 0, 0, random (0, 360), 2, random (10, 90))
		TNT1 AAAAA 0 A_CustomMissile ("Purple_FlyingBlood", 7, 0, random (0, 360), 2, random (30, 70))
		TNT1 AAA 0 A_CustomMissile ("PurpleBloodMistSpray", 0, 0, random (0, 360), 2, random (20, 90))
		Goto LowBlood

	AnimuGore:
		TNT1 AAA 0 A_CustomMissile ("Purple_FlyingBloodMuchFaster", 7, 0, random (0, 360), 2, random (10, 50))
		TNT1 A 0 A_CustomMissile ("SuperWallPurpleBlood", 0, 0, random (0, 360), 2, random (-15, 15))
		TNT1 A 0 A_CustomMissile ("Purple_FlyingBloodMuchFaster", 7, 0, random (0, 360), 2, random (40, 60))
		TNT1 AAAAAAA 0 A_CustomMissile ("Purple_FlyingBlood", 7, 0, random (0, 360), 2, random (30, 70))
		TNT1 AAAAAAAAA 0 A_CustomMissile ("XDeath1Purple", 0, 0, random (0, 360), 2, random (40, 80))
		TNT1 A 0 A_CustomMissile ("PurpleSuperGoreSpawner", 0, 0, random (0, 360), 2, random (10, 90))
		TNT1 AAAAA 0 A_CustomMissile ("PurpleBloodMistSpray", 0, 0, random (0, 360), 2, random (20, 90))
		Goto LowBlood

	LowBlood:
		TNT1 A 0
		TNT1 A 0 A_JumpIf((z - floorz) < 48, 2)
		TNT1 A 0 A_RadiusGive("BloodSplasher_Purple", 96, RGF_PLAYERS, 1)
		TNT1 AA 0
		BSPR BCDEFGHIJJJ 1
		Stop
	}
}

//Base flying blood actor. Leaves bloodspots on the floor
ACTOR Purple_FlyingBlood: Brutal_FlyingBlood 
{
	translation "168:191=[255,255,255]:[128,0,255]", "16:47=[196,136,255]:[51,0,102]"
	Decal PurpleBloodSplat
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Splash")
		TNT1 A 0 A_Jump(255, "Spawn1", "Spawn2", "Spawn3", "Live")
	Spawn1:
		TNT1 A 0
		TNT1 A 0 A_SetScale(-0.4, 0.4)
		Goto Live

	Spawn2:
		TNT1 A 0
		TNT1 A 0 A_SetScale(-0.45, -0.45)
		Goto Live

	Spawn3:
		TNT1 A 0
		TNT1 A 0 A_SetScale(0.5, -0.5)
		Goto Live

	Live:
		BLHT BCDEFG 1
		TNT1 A 0 
		BLHT HHHHH 100 A_JumpIf(waterlevel > 1, "Splash")
		Stop

	Splash:
		BLOD A 0
		TNT1 A 0 A_SpawnItem ("PurpleUnderblood2")
		stop

	Death:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("blooddrop2")
		TNT1 A 0 A_CheckFloor("DeathFloor")
		TNT1 A 1
		Stop
  
	DeathFloor:
		TNT1 A 0
		TNT1 A 0 A_SpawnItemEx ("Purple_BloodSpot",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION |  SXF_TRANSFERTRANSLATION,0)
		TNT1 A 0 A_PlaySound("blooddrop2")
		XDT1 EFGHIJKL 2
		Stop

	NoSpawn:
		TNT1 A 0
		Stop
	}
}

