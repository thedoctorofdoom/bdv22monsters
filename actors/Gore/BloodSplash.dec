actor BloodSplasher_Red : CustomInventory
{
	inventory.maxamount 0x7FFFFFFF
	+AUTOACTIVATE
	states
	{
	Use:
		TNT1 A 3
		/*TNT1 A 0 ACS_NamedExecuteAlways("ScreenEffects")
		TNT1 A 0 ACS_NamedExecuteAlways("BloodSplashTrail")
		TNT1 A 0 A_JumpIfInTargetInventory("BloodTrail", 1, 3)
		TNT1 A 0 A_JumpIfInTargetInventory("ScreenFX", 1, 2)*/
		TNT1 A 0 ACS_NamedExecuteAlways("BloodSplashRed", 0, 0, 0, 0)
		TNT1 A 0
		Stop
	}
}

