actor AlienHead1: PurpleLimbBase
{
	damagefactor "Kick", 99.0
	damagefactor "Melee", 99.0
	damagefactor "SuperPunch", 99.0
	damagefactor "Stealth", 0.0
	-CLIENTSIDEONLY
	+SHOOTABLE
	-THRUACTORS
	+LOOKALLAROUND
	-COUNTKILL
	damagefactor "Crush", 50.0
	damagefactor "Kick", 9000.0
	damagefactor "HeadKick", 9000.0
	damagefactor "Pick", 999.0
	Radius 10
	Mass 60
	Health 40
	Scale 1.1
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0
		//TNT1 A 0 A_QueueCorpse//
		11AG a -1
		Stop

	Pain:
		TNT1 A 0
		TNT1 A 0 ThrustThingZ(0,20,0,1)
		11AG ABCDEFGH 2
		Goto Spawn

	Death:
		TNT1 A 0
		TNT1 A 0 A_SpawnItem("AlienHeadExplode")
		Stop

	Death.Trample:
	Death.Stomp:
		TNT1 A 0 A_GiveToTarget("BootsSmearedWithPurpleBlood", 6)
		TNT1 A 0 A_Jump(255, "Death")
		Goto Death

	Crush:
		TNT1 AAAAAAAA 0 A_CustomMissile ("Purple_FlyingBloodTrail", 0, 0, random (0, 360), 2, random (60, 140))
		TNT1 A 0 A_PlaySound("misc/xdeath5")
		CRS1 B 5
		CRS1 B 9009
		Stop

	Death.plasma:
		TNT1 A 0
		TNT1 A 0 A_CustomMissile ("XDeathBurnedSkull", 2, 0, random (0, 360), 2, 270)
		EXPL A 0 A_CustomMissile ("ExplosionSmoke", 32, 0, random (0, 360), 2, random (0, 360))
		TNT1 A 0
		Stop

	Death.Kick:
		TNT1 A 0
		TNT1 A 0 A_NoBlocking
		SSHD EE 0 A_FaceTarget
		TNT1 AAAA 0 A_SpawnItemEx("Purple_Blood", 0, 0, 10)
		TNT1 A 0 A_CustomMissile ("AlienHead", 5, 0, random (170, 190), 2, random (20, 30))
		TNT1 A 0 A_PlaySound("misc/xdeath5", 1)
		TNT1 A 0 A_PlaySound("FOOTWALL", 3)
		TNT1 A 20
		Stop

	Death.Headkick:
		TNT1 A 0
		TNT1 A 0 A_NoBlocking
		11AG EE 0 A_FaceTarget
		TNT1 A 0 A_CustomMissile ("AlienHead", 5, 0, random (170, 190), 2, random (20, 30))
		TNT1 A 0 A_PlaySound("misc/xdeath5", 1)
		TNT1 A 0 A_PlaySound("FOOTWALL", 3)
		TNT1 A 20
		Stop

	Death.ExplosiveImpact:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 0)
		TNT1 A 0 ThrustThingZ(0,50,0,1)
		11AG ABCD 6
		11AG I 0 A_SpawnItem("AlienHead")
		Stop
	}
}

