        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0
		//TNT1 A 0 A_QueueCorpse//
		KE1G I 1 A_SpawnItem ("Brutal_BloodSpot", 0, 1)
		KE1G I -1
		Stop

	Death:
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodTrail", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 A 0 A_CustomMissile ("KeensGibHand", 0, 0, random (0, 180), 2, random (0, 180))
		TNT1 A 0 A_CustomMissile ("KeensGibArmPart", 0, 0, random (0, 180), 2, random (0, 180))
		Stop

	Death.plasma: 
	Death.Burn: 
	Death.Flames:
		TNT1 A 0 A_SpawnItemEx("TinyBurningPiece2", random (-15, 15), random (-15, 15))
		TNT1 A 0 A_SpawnItemEx("TinyBurningPiece3", random (-15, 15), random (-15, 15))
		TNT1 A 0 A_CustomMissile ("XDeathBurnedArm", 2, 0, random (0, 360), 2, 270)
		Stop

	Death.Kick:
	Death.Melee:
	Death.SuperPunch:
		KE1G I 1 A_FaceTarget
		TNT1 A 0 A_CustomMissile ("KeensArm", 5, 0, random (170, 190), 2, random (20, 40))
		Stop

	Pain:
		TNT1 A 0
