    SpawnLoop:
		//TNT1 A 0 A_QueueCorpse//
		ACA3 I 1900
		TNT1 A 0 A_JumpIfInventory("lowgraphicsmode", 1, "DoNothing")
		TNT1 A -1
		Stop

	Pain:
		TNT1 A 0
		TNT1 A 0 ThrustThingZ(0,30,0,1)
		ACA3 ABCDEFGH 2
		Goto Spawn

	Death:
