		TNT1 A 0 ThrustThingZ(0,30,0,1)
		KE1G A 6
		KE1G ABCDEFGHABCDEFGHABCDEFGH 6 A_CheckFloor("Landz")
		Goto Landz

	Landz:
		KE1G I 0 A_SpawnItem("KeensArm1")
		Stop
	}
}

