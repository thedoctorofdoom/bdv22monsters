Actor ExplosionParticle
{
	Height 1
	Radius 1
	Mass 0
	+Missile
	+NoBlockMap
	+DontSplash
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+THRUACTORS
	+GHOST
	-NOGRAVITY
	+THRUGHOST
	+NOTELEPORT
	RenderStyle "Add"
	Scale 0.8
	Gravity 1
	Speed 12
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		SPKO B 2 Bright A_FadeOut(0.04)
		Loop
	}
}


Actor ExplosionParticle2: ExplosionParticle
{
	Scale 0.1
	Speed 6
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		SPRK SSSSSSSS 2 BRIGHT
		SPRK SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS 2 Bright A_FadeOut(0.04)
		Stop
	}
}

