		BPRT A 1
		BPRT A 100
		Stop

	Death2:
		BPRT C 1
		BPRT C 100
		Stop

	Death3:
		BPRT E 1
		BPRT E 100
		Stop

	Death4:
		BPRT G 1
		BPRT G 100
		Stop

	Death5:
		BPRT B 1
		BPRT B 100
		Stop

	Death6:
		BPRT D 1
		BPRT D 100
		Stop
	}
}

