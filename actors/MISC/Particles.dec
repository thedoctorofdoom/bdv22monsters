ACTOR PlasmaHitFogNew: ExplosionParticle2
{
	Radius 1
	Height 1
	Alpha 1.0
	RenderStyle "Add"
	Scale 0.3
	Speed 3
	+NOGRAVITY
	+BOUNCEONCEILINGS
	+BOUNCEONWALLS
	-SKYEXPLODE
	States
	{
	Spawn: 
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 0
		TNT1 A 0 A_Jump(255, "Spawn1", "Spawn2", "Spawn3", "Live")
	Spawn1:
		TNT1 A 0
		TNT1 A 0 A_SetScale(-0.2, -0.2)
		Goto live

	Spawn2:
		TNT1 A 0
		TNT1 A 0 A_SetScale(0.4, -0.4)
		Goto live

	Spawn3:
		TNT1 A 0
		TNT1 A 0 A_SetScale(-0.6, 0.6)
		Goto live

	Live:
		PFOG ABCDEFG 1 BRIGHT
		Stop
	}
}

ACTOR GreenPlasmaHitFogNew: PlasmaHitFogNew
