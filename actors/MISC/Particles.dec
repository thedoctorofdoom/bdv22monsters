ACTOR MudDust
{
	Scale 1.0
	+noteleport
	+missile
	+forcexybillboard
	+CLIENTSIDEONLY
	+DOOMBOUNCE
	+THRUACTORS
	RenderStyle "Translucent"
	Alpha 0.6
	BounceFactor 0.01
	Speed 12
	Gravity 0.8
	height 1
	radius 1
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		DTXP A 1
		TNT1 A 0 A_Jump(255, "Spawn1", "Spawn2", "Spawn3", "Fly")
	Fly:
		DTXP A 2 //A_FadeOut(0.05)
		DTXP BCDEFGHIJKLMNOPQRSTUVWXYZ 1 //A_FadeOut(0.1)
		Stop

	Spawn1:
		DTXP A 1
		TNT1 A 0 A_SetScale(1.0, -1.0)
		Goto Fly

	Spawn2:
		DTXP A 1
		TNT1 A 0 A_SetScale(-1.0, -1.0)
		Goto Fly

	Spawn3:
		DTXP A 1
		TNT1 A 0 A_SetScale(-1.0, 1.0)
		Goto Fly

	Death:
		WTXP Z 1
		Stop
	}
}

