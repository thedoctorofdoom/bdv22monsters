// Extracted from actors/MISC/Dropables.dec and actors/MISC/Ammo.dec during
// Phase 2 DECORATE pruning. These are the "weapon falls out of a dying
// zombie/marine and lies on the ground" cosmetic drop props, still spawned by
// kept monster DropItem/A_SpawnItem death code. RifleDrop is the shared base
// class for the Shotgun/Chaingun/MP40 variants; Clip1/Clip1Drop is the
// matching pistol-ammo pickup prop referenced alongside them.

actor RifleDrop
{
	Radius 0
	Height 0
	+THRUACTORS
	states
	{
	Spawn:
		TRII A 0
		TNT1 A 0 A_Jump(128, "Spawn2")
		Goto Spawn1

	Spawn1:
		TNT1 A 0 A_CustomMissile ("DropedRifle", 20, 0, 0, 2, random (30, 50))
		stop

	Spawn2:
		TNT1 A 0 A_CustomMissile ("DropedRifle2", 20, 0, 180, 2, random (30, 50))
		stop
	}
}

ACTOR DropedRifle
{
	speed 6
	health 1
	radius 16
	height 4
	Gravity 0.9
	damage 0
	Scale 0.8
	Mass 1
	+EXPLODEONWATER
	+THRUACTORS
	+MISSILE
	+NOTELEPORT
	+NOBLOCKMAP
	+BLOODLESSIMPACT
	+FORCEXYBILLBOARD
	+NODAMAGETHRUST
	+MOVEWITHSECTOR
	+CORPSE
	-DONTSPLASH
	States
	{
	Spawn:
		TRII A 4
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		TRII BCDEFGH 4
		Loop

	Death:
		TNT1 A 0
		Stop
	}
}

ACTOR DropedRifle2: DropedRifle
{
	XScale -1.0
	States
	{
	Spawn:
		TRII H 4
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		TRII GFEDCBA 4

	Death:
		TNT1 A 0
		Stop
	}
}

