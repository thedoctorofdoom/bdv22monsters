Actor BUBULZ
{
	Height 0
	Radius 0
	Mass 0
	+Missile
	+NoBlockMap
	+NoGravity
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DOOMBOUNCE
	+NOTELEPORT
	+DontSplash
	RenderStyle "Add"
	Scale 0.5
	Speed 2
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(255, "Spawn1", "Spawn2")
	Spawn1:
		TNT1 A 0 ThrustThingZ(0,2,0,1)
		BUBL A 1 Bright A_JumpIf(waterlevel < 1, "Death")
		Stop

	Spawn2:
		TNT1 A 0 ThrustThingZ(0,2,0,1)
		BUBL B 1 Bright A_JumpIf(waterlevel < 1, "Death")
		Loop

	Death:
		TNT1 A 0
		Stop
	}
}

Actor EXPLOSIONBUBULZ: BUBULZ
{
	Speed 10
	+NOTELEPORT
	States
	{
	Spawn:
		BUBL A 10
		TNT1 A 0 A_Jump(255, "Spawn1", "Spawn2")
	Spawn1:
		BUBL A 1 BRIGHT A_JumpIf(waterlevel < 1, "Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL A 1 BRIGHT A_JumpIf(waterlevel < 1, "Death")
		Stop

	Spawn2:
		BUBL B 1 BRIGHT A_JumpIf(waterlevel < 1, "Death")
		TNT1 A 0 ThrustThingZ(0,4,0,1)
		BUBL B 1 BRIGHT A_JumpIf(waterlevel < 1, "Death")
		Stop
	}
}

Actor UnderwaterExplosion
{
	+NOCLIP
	+NOGRAVITY
	states
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_JumpIf(waterlevel < 1, "Stap")
		TNT1 AAAAA 0 A_CustomMissile ("BUBULZ", 0, 0, random (0, 360), 2, random (0, 180))
		TNT1 AAAAAAAAAA 0 A_CustomMissile ("EXPLOSIONBUBULZ", 0, 0, random (0, 360), 2, random (180, 360))
		Stop

	Stap:
		TNT1 A 0
		Stop
	}
}

Actor SmallUnderwaterExplosion
{
	+NOCLIP
	+NOGRAVITY
	states
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_JumpIf(waterlevel < 1, "Stap")
		TNT1 AAAA 0 A_CustomMissile ("BUBULZ", 0, 0, random (0, 360), 2, random (0, 180))
		TNT1 AAAAAAAAA 0 A_CustomMissile ("EXPLOSIONBUBULZ", 0, 0, random (0, 360), 2, random (180, 360))
		Stop

	Stap:
		TNT1 A 0
		Stop
	}
}

ACTOR ExplosionSplashSpawner
{
	+THRUACTORS
	+VULNERABLE
	Radius 1
	Height 1
	Gravity 4
	Mass 99999
	Health 99999
	+NOBLOODDECALS
	states
	{
	Spawn:
	Death:
		TNT1 A 0
		TNT1 A 0 ACS_NamedExecuteAlways("BDCheckFloorType3", 0, 0, 0, 0)//Check if is under grass/dirt
		TNT1 A 0 ThrustThingZ(0,-30,0,1)
		TNT1 A 3
		TNT1 A 0 A_CheckFloor("Spawn2")
		Stop

	Spawn2:
		TNT1 A 0
		TNT1 A 2
		TNT1 A 0 A_JumpIfInventory("IsOverWater", 1, "SpawnWater")
		Stop

	SpawnWater:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("bigspl1")
		TNT1 AAAAAAAAAAAAAAAAAAA 0 A_CustomMissile ("BlueLiquidParticleX", random (0, 40), 0, random (0, 360), 2, random (10, 90))
		TNT1 A 0 A_CustomMissile ("BlueLiquidParticleXNoMove", random (0, 2), 0, random (0, 360), 2, random (30, 90))
		TNT1 A 20
		Stop
	}
}

ACTOR LargeMassWaterImpact
{
	+THRUACTORS
	+VULNERABLE
	Radius 1
	Height 1
	Mass 99999
	Health 99999
	states
	{
	Spawn:
	Death:
		TNT1 A 0
		TNT1 A 0 ACS_NamedExecuteAlways("BDCheckFloorType3", 0, 0, 0, 0)//Check if is under grass/dirt
		TNT1 A 2
		TNT1 A 0 A_JumpIfInventory("IsOverWater", 1, "SpawnWater")
		Stop

	SpawnWater:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("bigspl1")
		TNT1 A 0 A_AlertMonsters(500, AMF_TARGETNONPLAYER)
		TNT1 AA 0 A_CustomMissile ("BlueLiquidParticleX", 12, 0, random (0, 360), 2, random (30, 90))
		TNT1 A 20
		Stop
	}
}
