// Extracted from actors/DECORATIONS/Splashes.dec and actors/PlayerClasses/Water.dec
// during Phase 2 DECORATE pruning. These are the small cosmetic blood/liquid
// particle actors that kept monster footstep code (Footsteps.dec), melee gore
// (Gore/*.dec), and the GoreThrows.dec extraction spawn via A_CustomMissile /
// A_SpawnItem. Only the leaf particle classes and the underwater-explosion pair
// (which only depends on the also-included BUBULZ/EXPLOSIONBUBULZ bubble
// actors) are extracted here.
//
// NOTE (residual, documented, low risk): ExplosionSplashSpawner and
// LargeMassWaterImpact (below) are extracted as-is from Water.dec because they
// are still referenced by kept code, but their own internal branches
// (SpawnSlime/SpawnNukage/SpawnBlood/SpawnBDLava/SpawnLava/SpawnGrass/SpawnSand)
// reference additional narrow, terrain-specific splash-particle classes that
// were NOT extracted (e.g. WaterParticleX* family, grass/sand splash decals).
// DECORATE resolves A_CustomMissile/A_SpawnItem class-name strings at state
// execution time, not compile time, so this does not break compilation or
// cause a crash - at worst a specific terrain-splash branch silently spawns
// nothing (ZDoom logs a warning) if that branch is ever reached. Flagged for
// human review; full resolution would require importing most of Water.dec's
// splash-particle subsystem.

Actor BloodParticleX
{
	Height 2
	Radius 2
	Mass 0
	+Missile
	+NoBlockMap
	-NoGravity
	+DontSplash
	+FORCEXYBILLBOARD
	+THRUACTORS
	+CLIENTSIDEONLY
	+NOTELEPORT
	Gravity 0.5
	RenderStyle "Add"
	Scale 1.0
	Alpha 0.5
	Speed 2
	States
	{
	Spawn:
	    TNT1 A 0 A_QueueCorpse
		BSPH ABCDDDDDD 4 A_QueueCorpse
		Stop

	Death:
	    TNT1 A 0 A_QueueCorpse
		BSPL ABCDEFGH 1
		Stop
	}
}

Actor BloodParticleXFAster: BloodParticleX { Speed 4 }

Actor BloodLiquidParticleX
{
	Height 1
	Radius 1
	Mass 0
	+Missile
	-NoGravity
	+DontSplash
	+BOUNCEONCEILINGS
	+FORCEXYBILLBOARD
	+THRUACTORS
	+CLIENTSIDEONLY
	+NOTELEPORT
	+DontSplash
	BounceFactor 0.1
	Gravity 0.5
	RenderStyle "Translucent"
	Scale 2.0
	Alpha 0.3
	//decal BloodWaterDecal
	Speed 7
	States
	{
	Spawn:
	    TNT1 A 0 A_QueueCorpse
		MSBL ABCDEFG 2 A_QueueCorpse
		MSBL H 100 A_QueueCorpse
		Stop

	Death:
	    TNT1 A 0 A_QueueCorpse
		TNT1 A 0 A_SetScale(1.9, 1.9)
		BSPL ABCDEFGH 1
		Stop
	}
}

Actor BlueLiquidParticleX: BloodLiquidParticleX
{
	//Translation "176:191=192:196"
	RenderStyle "Add"
	Alpha 0.6
	Scale 1.2
	Speed 10
	//decal BloodWaterDecal
	States
	{
	Spawn:
		WTXP ABCDEFGHIJKLMNOPQRSTUV 1
		WTXP W -1
		Stop

	Death:
		TNT1 A 0
		Stop
	}
}

