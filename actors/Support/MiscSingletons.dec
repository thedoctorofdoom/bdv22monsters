// Miscellaneous small, self-contained singleton actors extracted during
// Phase 2 DECORATE pruning, each still referenced from exactly one kept file.
// Parent classes used here (DoomWeapon, ExplosionFlames/FlameTrails) are
// already provided by other reachable includes (base game / actors/MISC/FIRE.dec).

// Referenced by actors/Enemies/LABGUY.dec (dropped-axe decoration prop).
// AxeAttack and the rest of the real AXE weapon in actors/Weapons/Axe.dec
// remain out of scope; only the world-model pickup prop is needed here.
ACTOR BrutalAxe : DoomWeapon
{
	States
	{
	Spawn:
		AXE9 A 1
		AXE9 A -1
		Stop
	}
}

// Referenced by actors/Enemies/Bosses/BossBrain.dec.
ACTOR NuclearFlames: ExplosionFlames
{
	Scale 2.2
	Speed 5
	RenderStyle "Add"
	States
	{
	Spawn:
		FLXP ABCDEFGHIJKLMNOPQRSTUVWXYZ 2 BRIGHT
		Stop
	}
}

// Referenced by actors/Enemies/ST Monsters/BELPHEGOR.dec.
ACTOR GreenExplosionFire
{
	Game Doom
	Radius 1
	Height 1
	Speed 3
	Damage 0
	+NOBLOCKMAP
	+NOTELEPORT
	+DONTSPLASH
	+MISSILE
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOCLIP
	RenderStyle "Add"
	DamageType Flames
	Scale 2.0
	Alpha 1
	Gravity 0
	States
	{
	Spawn:
		EXPG A 1
		EXPG ABCDEFG 3 BRIGHT
		Stop
	}
}

// Referenced by actors/Gore/DEAD.dec (a Step-2 replaces-stripped-only file;
// its actor bodies, including this A_SpawnItem call, are otherwise untouched).
Actor TVRRainSpawner
{
	Radius 1
	Height 1
	+NoClip
	+SpawnCeiling
	+NoGravity
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_PlaySoundEx("AMBRAIN", "SoundSlot7", 1)
		TNT1 A 0 ThrustThingZ(0,955,0,1)
		Goto Spawn2

	Spawn2:
		TNT1 A 1
		TNT1 A 1 A_SpawnItemEx("TVRRainDrop", Random(-48, 48), 0, -2, 0, 0, 0, Random(0, 360), 128, 1)
		TNT1 A 1
		Loop
	}
}

Actor TVRRainDrop
{
	+Missile
	-NoGravity
	+CLIENTSIDEONLY
	+DONTSPLASH
	Speed 0
	Height 2
	Radius 2
	RenderStyle "Translucent"
	Alpha 0.7
	Scale 1.0
	Mass 0
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_CheckCeiling("Nope")
		RNDA A 100
		Loop

	Death:
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckCeiling("Nope")
		RNDA BCDEFGHI 1
		RNDR BCDEFGH 1
		Stop

	Nope:
		TNT1 A 0
		Stop
	}
}

// Referenced by actors/Enemies/Bosses/BossBrain.dec.
Actor AltMap01CloudSpawner
{
	Radius 1
	Height 1
	+THRUACTORS
	+NOGRAVITY
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_SetAngle(90)
	Spawn2:
		TNT1 A 10
		TNT1 A 0 A_SpawnItemEx("AltMap01Cloud", 0, random(-850, 850), random(-85, 85))
		Loop
	}
}

ACTOR AltMap01Cloud
{
	Radius 128
	Height 128
	Speed 10
	Projectile
	+RANDOMIZE
	+THRUACTORS
	RenderStyle "Add"
	Alpha 1
	Scale 2.0
	SeeSound "imp/attack"
	DeathSound "imp/shotx"
	States
	{
	Spawn:
		FOGL A 4
		TNT1 A 0 A_Recoil(8)
		TNT1 A 0 A_Jump(32, "Spawn")
		FOGL A 10000
		Loop

	Death:
		TNT1 A 0
		Stop
	}
}

// Referenced by actors/Enemies/SPIDERS2.dec and actors/Enemies/ST Monsters/BELPHEGOR.dec.
// Originally from the excluded
// actors/PlayerClasses/Player.dec; only this one flying-blood particle actor
// is needed (its own spawned items, Brutal_FlyingBloodTrail/Brutal_BloodSpot,
// are already provided by the kept Gore/* includes).
ACTOR PlayerFlyingBlood
{
	game Doom
	scale 0.75
	speed 7
	health 1
	radius 8
	height 1
	Decal "BloodSuper"
	+MISSILE
	+CLIENTSIDEONLY
	+NOTELEPORT
	+NOBLOCKMAP
	+FORCEXYBILLBOARD
	+EXPLODEONWATER
	States
	{
	Spawn:
		NULL A 0 A_JumpIf(waterlevel > 1, "Splash")
		XDT1 ABCD 4 A_SpawnItem("Brutal_FlyingBloodTrail",0,0,0,1)
		loop

	Splash:
		BLOD A 0
		stop

	Death:
		NULL A 1 A_SpawnItem("Brutal_BloodSpot",0,0,0,1)
		XDT1 EFGHIJKL 3
		stop
	}
}

// Referenced by actors/Enemies/Bosses/BossBrain.dec (a "delete this actor
// completely" utility projectile, unrelated to the excluded MapEnhancementSystem
// map-decoration features despite living in the same donor file originally).
actor DeletusVeryLarge
{
	+NOTARGET
	Radius 10
	Height 10
	DamageType Deletus
	+NOGRAVITY
	+NOTELEPORT
	+NODAMAGETHRUST
	+THRUGHOST
	+NORADIUSDMG
	+NOEXTREMEDEATH
	+FORCERADIUSDMG
	-BLOODSPLATTER
	+BLOODLESSIMPACT
	PROJECTILE
	+DEHEXPLOSION
	+ACTIVATEMCROSS
	+NOINTERACTION
	+NOBLOCKMAP
	RenderStyle "None"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Explode(9999,9999)
		Stop
	}
}
