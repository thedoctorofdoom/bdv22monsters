// Extracted from actors/PlayerClasses/Teleports.dec and actors/PlayerClasses/CapturedMarine.dec
// during Phase 2 DECORATE pruning. BOdyRemovalThing is spawned by virtually every
// kept monster's death state (Imps/Demons/Barons/Archvile/Cyberdemon/Mastermind/
// Sergeants/Zombiemen/WCS/etc.) to silently clean up corpse remains. KillMe and
// BodyCrash1 are similarly used by a handful of kept monster files. The rest of
// Teleports.dec (map teleporter system) and CapturedMarine.dec (marine-capture
// mechanic) are out of scope and were intentionally left out of the include tree.

ACTOR BOdyRemovalThing
{
	+THRUACTORS
	+PAINLESS
	+NODAMAGETHRUST
	-BLOODSPLATTER
	+BLOODLESSIMPACT 
	+FORCERADIUSDMG
	+FLOORCLIP
	+DONTSPLASH
	+NOCLIP
	Mass 5
	Radius 1
	Height 1
	Damagetype "CrushedBodies"
	States
	{
	Death:
	Spawn:
		TNT1 A 0
		TNT1 A 0
		TNT1 A 0 A_Explode(8, 10, 0)
		TNT1 A 0 ThrustThingZ(0,-30,0,1)
		TNT1 A 1
		Stop
	}
}

actor KillMe
{
	+NOTARGET
	Radius 10
	Height 10
	DamageType KillMe
	+NOGRAVITY 
	+NOTELEPORT 
	+NODAMAGETHRUST
	+THRUGHOST 
	+NORADIUSDMG 
	+NOEXTREMEDEATH
	+FORCERADIUSDMG 
	-BLOODSPLATTER 
	+BLOODLESSIMPACT 
	PROJECTILE
	+DEHEXPLOSION
	+ACTIVATEMCROSS 
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Explode(3,500)
		Stop
	}
}

actor BodyCrash1
{
	Radius 16
	Height 2
	DamageType Fall
	+NOTELEPORT
	+NODAMAGETHRUST
	+FORCERADIUSDMG
	-BLOODSPLATTER
	+BLOODLESSIMPACT 
	PROJECTILE
	+MISSILE
	-NOGRAVITY
	-THRUACTORS
	+EXPLODEONWATER
	Gravity 1.0
	Speed 0
	Damage (random (90, 95))
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 4
		Stop

	Death:
	XDeath:
		TNT1 A 0 A_Explode(100,10)
		Stop
	}
}
