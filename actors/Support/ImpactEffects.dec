ACTOR FireworkSFXType1
{
	Radius 4
	Height 4
	Speed 18
	PROJECTILE
	+THRUGHOST
	+CLIENTSIDEONLY
	+NOBLOCKMAP
	RenderStyle "None"
	-NOGRAVITY
	Gravity 1
	Alpha 1.0
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse//

    SpawnLoop:
		TNT1 A 0 A_SpawnItem ("SmallFlameTrails")
		TNT1 A 1 A_SpawnItem("RedFlareSmall")
		TNT1 A 1 A_SpawnItem("RedFlareSmall")
		Loop

	Death:
		TNT1 A 0 A_SpawnItemEx("TinyBurningPiece", random (-15, 15), random (-15, 15))
		Stop
	}
}

