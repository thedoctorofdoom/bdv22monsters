// Extracted from actors/DECORATIONS/FIREWORKS.dec during Phase 2 DECORATE pruning.
// These are generic explosion/shrapnel/impact FX actors used throughout the kept
// monster and weapon files (A_CustomMissile/A_SpawnItemEx calls), NOT decorative
// map-placed barrel objects. The purely-decorative barrel actors (ExplodedBarrelRemains,
// ExplosiveBarrel1, VanillaExplosiveBarrel, GrinderBarrel1) were intentionally left
// behind in DECORATIONS/FIREWORKS.dec (no longer included) since nothing in the
// kept monster/gore/weapon code references them.

ACTOR BarrelShrapnel1
{
	Radius 2
	Height 2
	Speed 20
	Mass 1
	+NOBLOCKMAP
	+MISSILE
	+NOTELEPORT
	+MOVEWITHSECTOR
	+CLIENTSIDEONLY
	+THRUACTORS
	+FLOORCLIP
	+DOOMBOUNCE
	-NOGRAVITY
	+FORCEXYBILLBOARD
	BounceFactor 0.5
	Gravity 0.9
	Mass 1
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		BRPT A 0 A_SetScale(frandom(1.0,1.7))
		BRPT A 0 A_JumpIf(waterlevel > 1, "Underwater")
		BRPT ABCDEFGH 1
		TNT1 A 0 A_ChangeFlag("NOGRAVITY", 0)
		Goto Spawn2

	Spawn2:
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Underwater")
		BRPT ABCDEFGH 2
		Loop

	Death:
		TNT1 A 0
		BRPT I 300
		BRPT IIIIIIIII 2 A_FadeOut(0.1)
		Stop

	Underwater:
	Splash:
		Goto Death
	}
}

ACTOR BarrelShrapnel2: BarrelShrapnel1
{
	Scale 1.7
}

ACTOR BarrelShrapnel3: BarrelShrapnel1
{
	Scale 1.4
}

ACTOR BarrelShrapnel4: BarrelShrapnel1
{
	Scale 1.2
}

actor GreatKaboom
{
	Game Doom
	RenderStyle "None"
	+NOBLOCKMAP
	+CLIENTSIDEONLY
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 50
		TNT1 A 0 A_SpawnItemEx ("ExplosionSplashSpawner", 0, 0, 0)
		TNT1 AAAA 0 A_CustomMissile ("ExplosionSpawner", 20, 0, random (0, 360), 2, random (0, 180))
		TNT1 AAAAAA 0 A_CustomMissile ("ExplosionSpawner", 20, 0, random (0, 360), 2, random (0, 180))
		Stop
	}
}

actor BarrelKaboom: GreatKaboom
{
	Game Doom
	RenderStyle "None"
	+NOBLOCKMAP
	States
	{
	Spawn:
        TNT1 A 0 A_JumpIfInventory("CorpseQueued", 1, "SpawnLoop")
        TNT1 A 0 A_GiveInventory("CorpseQueued", 1)
        TNT1 A 0 A_QueueCorpse

    SpawnLoop:
		TNT1 A 1
		TNT1 AAAA 0 A_CustomMissile ("ExplosionSpawner", 10, 0, random (0, 360), 2, random (10, 90))
		Stop
	}
}

